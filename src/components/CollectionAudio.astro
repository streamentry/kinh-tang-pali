---
import type { AudioPlayerData } from '../lib/canon/audio';
import type { AudioVersionId, AudioVersionPlayerData } from '../lib/canon/audio';
import { EXPLANATION_AUDIENCE_LABELS } from '../lib/canon/explanation-audio';
import { locatePart } from '../lib/audio/parts';
import { playlistPayload } from '../lib/canon/audio-playlist';

interface PlaylistTrack extends AudioPlayerData {
  title: string;
  order: number;
}

interface Props {
  collectionTitle: string;
  totalSuttas: number;
  tracks: PlaylistTrack[];
  playlistUrl?: string;
}

const { collectionTitle, totalSuttas, tracks, playlistUrl } = Astro.props;
const payload = playlistPayload(tracks, playlistUrl);
const first = tracks[0];
const original = first?.versions.find((version) => version.id === 'original');
const completeVersions = new Set((['original','children','adults','older-adults'] as AudioVersionId[])
  .filter((id) => tracks.length > 0 && tracks.every((track) => track.versions.some((version) => version.id === id))));
const versionLabels: Record<AudioVersionId, string> = {
  original: original?.label ?? 'Kinh văn Việt 2026',
  children: EXPLANATION_AUDIENCE_LABELS.children.title,
  adults: EXPLANATION_AUDIENCE_LABELS.adults.title,
  'older-adults': EXPLANATION_AUDIENCE_LABELS['older-adults'].title,
};
const timestamp = (seconds: number) => `${Math.floor(seconds / 60)}:${Math.floor(seconds % 60).toString().padStart(2, '0')}`;
const audioHref = (version: AudioVersionPlayerData) => {
  if (version.parts?.length) {
    const position = locatePart(version.parts, version.start_seconds);
    const part = version.parts[position.index];
    return position.time > 0 ? `${part.url}#t=${position.time}` : part.url;
  }
  return version.start_seconds > 0 ? `${version.url}#t=${version.start_seconds}` : version.url;
};
---
<sutta-playlist class="collection-audio" data-collection-title={collectionTitle} data-tracks={JSON.stringify(payload.inline)} data-tracks-src={payload.url} data-track-count={tracks.length} data-complete-versions={JSON.stringify([...completeVersions])}>
  {first && (
    <section class="listening collection-listening" data-pagefind-ignore aria-label={`Trình phát ${collectionTitle}`}>
      <div class="listening-heading">
        <div>
          <p class="listening-label">Nghe các bài đã có audio</p>
          <h2>{collectionTitle}</h2>
        </div>
        <span class="listening-length">{tracks.length} / {totalSuttas} bài có audio</span>
      </div>
      <audio controls preload="metadata" src={original ? audioHref(original) : first.url} data-track-uid={first.uid} aria-label={`Nghe ${collectionTitle}`}></audio>
      {tracks.some(track => track.parts) && <details><summary>Các phần MP3</summary>{tracks.filter(track => track.parts).map(track => <div><p>{track.title}</p><ol class="listen-part-files">{track.parts!.map((part, i) => <li><a href={part.url} target="_blank" rel="noopener">Phần {i + 1} / {track.parts!.length}</a></li>)}</ol></div>)}</details>}
      <p class="listen-error" data-playlist-error role="status" hidden>Không tải được danh sách phát. Bạn vẫn có thể nghe từng MP3.</p>
      <div class="listening-custom" hidden>
        <div class="collection-audio-current" aria-live="polite">
          <div>
            <p class="eyebrow" data-playback-state>Bài đang chọn</p>
            <h3 data-current-title>{first.title}</h3>
          </div>
          <div class="collection-audio-current-meta">
            <span class="uid" data-current-uid>{first.uid.toUpperCase()}</span>
            <span class="listening-review" data-current-review hidden>Chờ nghe duyệt</span>
            <span class="listening-length" data-position>1 / {tracks.length}</span>
          </div>
        </div>
        <div class="listening-console collection-audio-console">
          <div class="listening-transport" role="group" aria-label="Điều khiển danh sách audio">
            <button class="listen-neighbour" type="button" data-previous disabled aria-label="Bài audio trước">
              <span aria-hidden="true">←</span><span class="collection-control-long">Bài trước</span><span class="collection-control-short">Trước</span>
            </button>
            <button class="listen-play" type="button" data-master-play aria-label={`Phát ${first.uid.toUpperCase()}`} aria-pressed="false">
              <span aria-hidden="true">▶</span><span data-play-label>Phát</span>
            </button>
            <button class="listen-neighbour" type="button" data-next aria-label="Bài audio tiếp theo">
              <span class="collection-control-long">Bài tiếp</span><span class="collection-control-short">Tiếp</span><span aria-hidden="true">→</span>
            </button>
          </div>
          <div class="listening-timeline">
            <div class="listen-track">
              <span class="listen-rail" aria-hidden="true"><span class="listen-progress"></span></span>
              <input class="listen-seek" type="range" min="0" max={first.duration_seconds} step="1" value="0" aria-label="Vị trí phát" />
            </div>
            <div class="listen-clock">
              <span><span data-current>0:00</span><span class="listen-phase" data-phase>{first.scripture_start_seconds > 0 ? 'Tóm tắt' : 'Kinh văn'}</span></span>
              <span data-duration>{timestamp(first.duration_seconds)}</span>
            </div>
          </div>
        </div>
        <div class="listening-options collection-audio-options">
          <label class="listen-version">
            <span>Bản nghe</span>
            <select aria-label="Chọn bản audio cho danh sách" data-version-select>
              {(['original','children','adults','older-adults'] as AudioVersionId[]).map((id) => (
                <option value={id} selected={id === 'original'} disabled={!completeVersions.has(id)}>
                  {versionLabels[id]}{completeVersions.has(id) ? '' : ' — chưa đủ audio trong danh sách'}
                </option>
              ))}
            </select>
          </label>
          <p class="listen-version-description" data-version-description>{original?.description ?? 'Bản audio chuẩn hiện có.'}</p>
          <label class="listen-auto"><input type="checkbox" role="switch" checked data-auto-next /><span>Tự chuyển bài</span></label>
          <label class="listen-speed">Tốc độ <select aria-label="Tốc độ phát"><option value="0.85">0.85×</option><option value="1" selected>1×</option><option value="1.15">1.15×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option></select></label>
        </div>
        <p class="listen-notice" data-notice role="status" aria-live="polite" hidden></p>
        <p class="listen-error" data-error role="status" aria-live="polite" hidden>Không tải được âm thanh. Hãy thử lại hoặc mở MP3 trực tiếp.</p>
        <div class="listening-footer">
          <a class="listen-file" data-open-track href={first.url} target="_blank" rel="noopener">Mở MP3 <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  )}
  <slot />
</sutta-playlist>

<script>
  import { AUDIO_VERSION_KEY, AUTO_NEXT_KEY, readAudioVersion, readAutoNext, saveAudioVersion, saveAutoNext, stepAudioIndex, playlistIndexFromHash, playlistTrackUrl } from '../lib/audio/navigation';
  import { playFailure } from '../lib/audio/playback';
  import { ReadingPlayer } from '../lib/audio/parts';
  import { parsePlaylist, type PlayerTrack } from '../lib/audio/playlist';
  import type { AudioVersionId, AudioVersionPlayerData } from '../lib/canon/audio';

  class SuttaPlaylistElement extends HTMLElement {
    private cleanup?: () => void;
    private connection = 0;

    disconnectedCallback() {
      this.cleanup?.();
      this.connection++;
      delete this.dataset.ready;
    }

    async connectedCallback() {
      if (this.dataset.ready) return;
      const connection = ++this.connection;
      this.dataset.ready = 'loading';
      let tracks: PlayerTrack[];
      try {
        if (this.dataset.tracksSrc) {
          const response = await fetch(this.dataset.tracksSrc);
          if (!response.ok) throw new Error('Playlist unavailable');
          tracks = parsePlaylist(await response.json(), Number(this.dataset.trackCount));
        } else tracks = parsePlaylist(JSON.parse(this.dataset.tracks ?? '[]'), Number(this.dataset.trackCount));
      } catch {
        if (connection === this.connection) this.querySelector<HTMLElement>('[data-playlist-error]')?.removeAttribute('hidden');
        return; // Native player and every row's MP3 link remain usable.
      }
      if (!this.isConnected || connection !== this.connection || !Array.isArray(tracks)) return;
      if (!tracks.length) return;
      this.dataset.ready = 'true';

      const audio = this.querySelector('audio')!;
      const custom = this.querySelector<HTMLElement>('.listening-custom')!;
      const play = this.querySelector<HTMLButtonElement>('[data-master-play]')!;
      const previous = this.querySelector<HTMLButtonElement>('[data-previous]')!;
      const next = this.querySelector<HTMLButtonElement>('[data-next]')!;
      const seek = this.querySelector<HTMLInputElement>('.listen-seek')!;
      const progress = this.querySelector<HTMLElement>('.listen-progress')!;
      const versionSelect = this.querySelector<HTMLSelectElement>('[data-version-select]')!;
      const versionDescription = this.querySelector<HTMLElement>('[data-version-description]')!;
      const autoNext = this.querySelector<HTMLInputElement>('[data-auto-next]')!;
      const speed = this.querySelector<HTMLSelectElement>('.listen-speed select')!;
      const error = this.querySelector<HTMLElement>('[data-error]')!;
      const notice = this.querySelector<HTMLElement>('[data-notice]')!;
      const format = (value: number) => `${Math.floor(value / 60)}:${Math.floor(value % 60).toString().padStart(2, '0')}`;
      let activeIndex = 0;
      let playbackRequest = 0;
      const completeVersions = new Set((['original','children','adults','older-adults'] as AudioVersionId[])
        .filter((id) => tracks.every((track) => track.versions.some((version) => version.id === id))));
      Array.from(versionSelect.options).forEach((option) => { option.disabled = !completeVersions.has(option.value as AudioVersionId); });
      let selectedVersion: AudioVersionId;
      let preferredVersion: AudioVersionId = 'original';
      try {
        preferredVersion = readAudioVersion(localStorage);
        selectedVersion = completeVersions.has(preferredVersion) ? preferredVersion : 'original';
      } catch { selectedVersion = 'original'; }
      const preferenceUnavailable = preferredVersion !== selectedVersion;
      versionSelect.value = selectedVersion;
      let enabled = true;
      try { enabled = readAutoNext(localStorage); } catch { /* Storage itself may be denied. */ }
      autoNext.checked = enabled;

      const activeTrack = () => tracks[activeIndex];
      const versionFor = (track: PlayerTrack, id: AudioVersionId) => track.versions.find((version) => version.id === id);
      const firstVersion = versionFor(tracks[0], selectedVersion) ?? versionFor(tracks[0], 'original')!;
      let activeVersion: AudioVersionPlayerData | null = firstVersion;
      const rememberTrackLocation = () => {
        const url = playlistTrackUrl(window.location.href, activeTrack().uid);
        if (url === window.location.href) return;
        try { history.replaceState(history.state, '', url); } catch { /* Playback still works when history access is denied. */ }
      };
      const say = (message: string) => { notice.textContent = message; notice.hidden = false; };
      if (preferenceUnavailable) say('Bản nghe bạn chọn chưa có trên toàn bộ danh sách; đang chọn bản chuẩn.');
      if (preferredVersion !== selectedVersion) say('Bản nghe bạn chọn chưa có ở toàn bộ danh sách; đang chọn bản chuẩn.');
      const media = new ReadingPlayer(audio, firstVersion, failure => {
        if (playFailure(failure) === 'blocked') say('Bấm Phát để nghe tiếp phần này.');
        else if (playFailure(failure) === 'unavailable') error.hidden = false;
      });
      audio.dataset.trackUid = tracks[0].uid;
      audio.dataset.trackVersion = firstVersion.id;
      if (firstVersion.id !== 'original') media.select(firstVersion);
      else if (firstVersion.start_seconds > 0) media.seek(firstVersion.start_seconds);
      const duration = () => media.duration;
      const update = () => {
        const track = activeTrack();
        const version = activeVersion;
        const currentTime = version ? media.currentTime : 0;
        const currentDuration = version ? duration() : 0;
        this.querySelector('[data-current-title]')!.textContent = version ? `${track.title} · ${version.label}` : track.title;
        this.querySelector('[data-current-uid]')!.textContent = track.uid.toUpperCase();
        this.querySelector('[data-position]')!.textContent = `${activeIndex + 1} / ${tracks.length}`;
        const review = this.querySelector<HTMLElement>('[data-current-review]')!;
        review.hidden = !version || version.review_status !== 'pending';
        this.querySelector('[data-current]')!.textContent = format(currentTime);
        this.querySelector('[data-duration]')!.textContent = format(currentDuration);
        const phase = !version ? 'Chưa có bản nghe' : version.kind === 'explanation' ? 'Diễn giải'
          : currentTime >= version.scripture_start_seconds ? 'Kinh văn' : 'Tóm tắt';
        this.querySelector('[data-phase]')!.textContent = phase;
        if (version && media.partCount > 1) this.querySelector('[data-phase]')!.textContent += ` · Phần ${media.partNumber}/${media.partCount}`;
        seek.max = String(currentDuration); seek.disabled = !version;
        seek.value = String(currentTime);
        seek.setAttribute('aria-valuetext', `${format(currentTime)} / ${format(currentDuration)}`);
        progress.style.width = currentDuration > 0 ? `${Math.max(0, Math.min(100, currentTime / currentDuration * 100))}%` : '0%';
        const playing = Boolean(version && !audio.paused && !media.ended);
        this.querySelector('[data-playback-state]')!.textContent = !version ? 'Audio phiên bản này chưa có' : playing ? 'Đang phát' : 'Bài đang chọn';
        play.setAttribute('aria-pressed', String(playing));
        play.disabled = !version;
        play.setAttribute('aria-label', `${playing ? 'Tạm dừng' : 'Phát'} ${track.uid.toUpperCase()}${version ? ` · ${version.label}` : ''}`);
        this.querySelector('[data-play-label]')!.textContent = playing ? 'Tạm dừng' : 'Phát';
        previous.disabled = stepAudioIndex(activeIndex, tracks.length, -1) === null;
        next.disabled = stepAudioIndex(activeIndex, tracks.length, 1) === null;
        this.querySelector<HTMLAnchorElement>('[data-open-track]')!.href = version ? media.url : '#';
        this.querySelector<HTMLAnchorElement>('[data-open-track]')!.setAttribute('aria-label', `Mở MP3 ${track.uid.toUpperCase()}${version ? ` · ${version.label}` : ''}`);
        versionDescription.textContent = version?.description ?? 'Chọn một bài có audio cho phiên bản này.';
        this.querySelectorAll<HTMLButtonElement>('[data-play-track]').forEach((button) => {
          const isPlaying = button.dataset.playTrack === track.uid && playing;
          const rowTrack = tracks.find((item) => item.uid === button.dataset.playTrack);
          const rowVersion = rowTrack ? versionFor(rowTrack, selectedVersion) : undefined;
          button.disabled = !rowVersion;
          button.dataset.playing = String(isPlaying);
          button.setAttribute('aria-pressed', String(isPlaying));
          button.setAttribute('aria-label', rowVersion
            ? `${isPlaying ? 'Dừng' : 'Phát'} ${button.dataset.playTrack!.toUpperCase()} · ${button.dataset.trackTitle} · ${rowVersion.label}`
            : `Chưa có audio ${selectedVersion} cho ${button.dataset.playTrack!.toUpperCase()}`);
          button.querySelector('[data-row-label]')!.textContent = rowVersion ? isPlaying ? 'Dừng' : 'Phát' : 'Chưa có';
          const row = button.closest<HTMLElement>('[data-audio-row]');
          if (row) row.dataset.currentAudio = String(button.dataset.playTrack === track.uid);
        });
      };

      const selectVersion = (versionId: AudioVersionId) => {
        if (!completeVersions.has(versionId)) { versionSelect.value = selectedVersion; return; }
        selectedVersion = versionId;
        versionSelect.value = selectedVersion;
        try { saveAudioVersion(localStorage, selectedVersion); } catch { /* Keep the in-page choice. */ }
        audio.pause(); error.hidden = true; notice.hidden = true;
        const version = versionFor(activeTrack(), selectedVersion);
        if (!version) {
          activeVersion = null;
          say(`Bản “${versionSelect.selectedOptions[0]?.textContent ?? selectedVersion}” chưa có audio cho bài này.`);
          update();
          return;
        }
        activeVersion = version;
        media.select(version);
        if (version.start_seconds > 0) media.seek(version.start_seconds);
        audio.dataset.trackVersion = version.id;
        update();
      };

      const selectTrack = async (index: number, autoplay = true) => {
        const track = tracks[index];
        if (!track) return;
        const request = ++playbackRequest;
        error.hidden = true;
        notice.hidden = true;
        const version = versionFor(track, selectedVersion);
        activeIndex = index;
        rememberTrackLocation();
        if (!version) {
          audio.pause(); activeVersion = null;
          say(`Bản “${versionSelect.selectedOptions[0]?.textContent ?? selectedVersion}” chưa có audio cho ${track.uid.toUpperCase()}.`);
          update();
          return;
        }
        if (audio.dataset.trackUid !== track.uid || audio.dataset.trackVersion !== version.id) {
          media.select(version);
          audio.dataset.trackUid = track.uid;
          audio.dataset.trackVersion = version.id;
          if (version.start_seconds > 0) media.seek(version.start_seconds);
        } else if (media.ended) media.seek(version.start_seconds);
        activeVersion = version;
        update();
        if (autoplay) {
          try { await audio.play(); } catch (failure) {
            if (request !== playbackRequest) return;
            // Name the actual cause: a blocked autoplay is not a broken file, and the reverse.
            const cause = playFailure(failure);
            if (cause === 'blocked') say('Trình duyệt chưa cho phép phát tự động. Bấm Phát để nghe tiếp.');
            else if (cause === 'unavailable') error.hidden = false;
            update();
          }
        }
      };

      autoNext.addEventListener('change', () => {
        enabled = autoNext.checked;
        try { saveAutoNext(localStorage, enabled); } catch { /* Keep the in-page choice if storage is denied. */ }
      });
      versionSelect.addEventListener('change', () => selectVersion(versionSelect.value as AudioVersionId));
      const onStorage = (event: StorageEvent) => {
        if (event.key === AUTO_NEXT_KEY || event.key === null) {
          try { enabled = readAutoNext(localStorage); autoNext.checked = enabled; } catch { /* Keep current choice. */ }
        }
        if (event.key === AUDIO_VERSION_KEY || event.key === null) {
          try {
            const preferred = readAudioVersion(localStorage);
            if (completeVersions.has(preferred) && preferred !== selectedVersion) selectVersion(preferred);
          } catch { /* Keep the in-page choice if storage is unavailable. */ }
        }
      };
      window.addEventListener('storage', onStorage);
      const onHashChange = () => {
        const index = playlistIndexFromHash(window.location.hash, tracks);
        if (index !== null && index !== activeIndex) void selectTrack(index, false);
      };
      window.addEventListener('hashchange', onHashChange);
      this.cleanup = () => {
        window.removeEventListener('storage', onStorage);
        window.removeEventListener('hashchange', onHashChange);
        media.destroy();
      };

      play.addEventListener('click', async () => {
        const request = ++playbackRequest;
        error.hidden = true;
        notice.hidden = true;
        if (!activeVersion) { say('Bản này chưa có audio. Chọn bài khác hoặc phiên bản khác.'); return; }
        if (!audio.paused) audio.pause();
        else {
          if (media.ended) media.seek(activeVersion.start_seconds);
          try { await audio.play(); } catch (failure) {
            if (request !== playbackRequest) return;
            const cause = playFailure(failure);
            if (cause === 'blocked') say('Trình duyệt chưa cho phép phát. Bấm Phát lần nữa để nghe.');
            else if (cause === 'unavailable') error.hidden = false;
          }
        }
        update();
      });
      previous.addEventListener('click', () => {
        const index = stepAudioIndex(activeIndex, tracks.length, -1);
        if (index !== null) void selectTrack(index);
      });
      next.addEventListener('click', () => {
        const index = stepAudioIndex(activeIndex, tracks.length, 1);
        if (index !== null) void selectTrack(index);
      });
      seek.addEventListener('input', () => { media.seek(Number(seek.value)); update(); });
      speed.addEventListener('change', () => { media.setPlaybackRate(Number(speed.value)); });
      this.querySelectorAll<HTMLButtonElement>('[data-play-track]').forEach((button) => {
        button.hidden = false;
        const fallback = button.closest('.sutta-row-audio')?.querySelector<HTMLElement>('[data-audio-fallback]');
        if (fallback) fallback.hidden = true;
        button.addEventListener('click', async () => {
          const index = tracks.findIndex(track => track.uid === button.dataset.playTrack);
          if (index < 0) return;
          if (index === activeIndex && !audio.paused && !media.ended) {
            playbackRequest++;
            error.hidden = true;
            notice.hidden = true;
            audio.pause();
            if (activeVersion) media.seek(activeVersion.start_seconds);
            update();
          } else {
            await selectTrack(index);
          }
        });
      });
      audio.addEventListener('loadedmetadata', update);
      audio.addEventListener('durationchange', update);
      audio.addEventListener('timeupdate', update);
      audio.addEventListener('play', () => { rememberTrackLocation(); error.hidden = true; notice.hidden = true; update(); });
      audio.addEventListener('pause', update);
      audio.addEventListener('ended', () => {
        update();
        if (!enabled) { say('Bài đã phát hết. Tự chuyển bài đang tắt.'); return; }
        const index = stepAudioIndex(activeIndex, tracks.length, 1);
        if (index === null) {
          say(`Đã nghe hết các bài có audio trong ${this.dataset.collectionTitle}.`);
          return;
        }
        void selectTrack(index);
      });
      audio.addEventListener('error', () => { error.hidden = false; update(); });
      // The file may have failed before this listener existed (it starts loading with the page).
      if (audio.error) error.hidden = false;
      audio.controls = false;
      audio.hidden = true;
      custom.hidden = false;
      const linkedIndex = playlistIndexFromHash(window.location.hash, tracks);
      if (linkedIndex !== null) void selectTrack(linkedIndex, false);
      else update();
    }
  }

  if (!customElements.get('sutta-playlist')) customElements.define('sutta-playlist', SuttaPlaylistElement);
</script>
