---
import Base from '../layouts/Base.astro';
import { listCollection, collectionProgress } from '../lib/canon/load';
import type { CollectionCode } from '../lib/canon/types';
import { withBase } from '../lib/url';
import { coverCollections } from '../lib/canon/covers';
import CollectionAudio from '../components/CollectionAudio.astro';
import { hasAudioRegistration, loadAudio } from '../lib/canon/audio';
import { composeDocument } from '../lib/canon/document';
import { orderedAudioItems } from '../lib/audio/navigation';
import { collectionPageCount, collectionPageSize } from '../lib/collection-pagination';
import CollectionPagination from './CollectionPagination.astro';
import SuttaRow from './SuttaRow.astro';
import GroupList from './GroupList.astro';
import { childGroups, groupHref, groupRange, groupTitle, hasNavigation, levelLabel, loadNavigation } from '../lib/canon/groups';

interface Props {
  collection: import('../lib/canon/types').CollectionDefinition;
  page?: number;
}

const { collection, page = 1 } = Astro.props;
const code = collection.code as CollectionCode;
// SN, AN and KN list "all texts" in the traversal order of the pinned tree; the catalogue's
// historical `order` (an2.1 → an2.10 → an2.100) is left untouched but no longer shown.
const navigation = hasNavigation(code) ? loadNavigation(code) : undefined;
const position = new Map(navigation?.order.map((uid, index) => [uid, index]) ?? []);
const missing = navigation ? listCollection(code).filter((item) => !position.has(item.uid)).map((item) => item.uid) : [];
if (missing.length) throw new Error(`${code}: ${missing.length} catalogue text(s) are not in content/navigation/traditional/${code}.json (${missing.slice(0, 5).join(', ')}) — run: npm run navigation:generate`);
const listed = navigation
  ? [...listCollection(code)].sort((a, b) => position.get(a.uid)! - position.get(b.uid)!)
  : listCollection(code);
const topGroups = navigation ? childGroups(code as 'sn' | 'an' | 'kn', navigation.rootId) : [];
const nested = topGroups.length > 0 && topGroups.length <= 6;
const items = listed.map((item) => ({
  ...item,
  audio: hasAudioRegistration(item.uid) ? loadAudio(composeDocument(code, item.uid)) : null,
}));
// The playlist follows the order the list shows: tree traversal for SN/AN/KN, catalogue order for DN/MN.
const tracks = (navigation ? items.filter((item) => item.audio) : orderedAudioItems(items)).flatMap((item) => item.audio ? [{
  ...item.audio,
  uid: item.uid,
  title: item.title,
  order: item.order,
}] : []);
const pageSize = collectionPageSize(code);
const pageCount = collectionPageCount(code, items.length);
const offset = (page - 1) * pageSize;
const visibleItems = items.slice(offset, offset + pageSize);
const progress = collectionProgress(code);
const withCovers = coverCollections.includes(code);
---
<Base description={`${collection.titleVi} (${collection.titlePali}): mục lục bài kinh, bản Pāli và các bản dịch đối chiếu, kèm trạng thái biên tập của dự án.`} title={`${collection.titleVi}${page > 1 ? ` · Trang ${page}` : ""} · Kinh Tạng Pāli Việt`}>
  <main id="main-content" tabindex="-1" class="page collection-page">
    <a class="back-link" href={withBase()}>← Năm bộ kinh</a>
    <header class="collection-header">
      <p class="eyebrow">{code.toUpperCase()}</p>
      <h1>{collection.titleVi}</h1>
      <p class="pali-title large">{collection.titlePali}</p>
      <p>{collection.description}</p>
      {progress.total > 0 && (
        <div class="stats">
          <span><strong>{progress.total}</strong> bài</span>
          <span><strong>{progress.started}</strong> đã bắt đầu</span>
          <span><strong>{progress.published}</strong> published</span>
        </div>
      )}
    </header>

    {page === 1 && topGroups.length > 0 && (
      <section class="collection-groups" aria-labelledby="muc-luc-nhom">
        <h2 id="muc-luc-nhom">Mục lục theo nhóm</h2>
        <p class="collection-groups-note">Theo cây mục lục truyền thống của SuttaCentral. Mỗi nhóm có trang riêng với các nhóm con, bài thành viên và đọc liên tục.</p>
        {nested ? topGroups.map((group) => (
          <section class="collection-group-block" aria-labelledby={`nhom-${group.id}`}>
            <h3 id={`nhom-${group.id}`}>
              <a href={withBase(groupHref(group.collection, group.id))}>{groupTitle(group).primary}</a>
              <span class="group-meta"><span>{levelLabel(group)}</span><span class="uid">{groupRange(group)}</span><span>{group.textCount} mục</span></span>
            </h3>
            <GroupList groups={childGroups(group.collection, group.id)} label={`Các nhóm trong ${groupTitle(group).primary}`} />
          </section>
        )) : <GroupList groups={topGroups} label={`Các nhóm trong ${collection.titleVi}`} />}
      </section>
    )}
    {topGroups.length > 0 && items.length > 0 && <h2 class="collection-all-heading" id="tat-ca-bai">Tất cả bài</h2>}
    {items.length > 0 ? (
      <CollectionAudio collectionTitle={collection.titleVi} totalSuttas={items.length} tracks={tracks}>
        {pageCount > 1 && <p class="collection-page-range" id="collection-page-range">Bài {offset + 1}–{Math.min(offset + pageSize, items.length)} / {items.length} · Trang {page} / {pageCount}. <a href={withBase('search/')}>Tìm trong toàn bộ kinh tạng</a></p>}
        <CollectionPagination code={code} page={page} pageCount={pageCount} position="top" />
        <ol start={offset + 1} class:list={['sutta-list', withCovers && 'has-covers']}>
          {visibleItems.map((item) => <SuttaRow code={code} item={item} withCovers={withCovers} />)}
        </ol>
        <CollectionPagination code={code} page={page} pageCount={pageCount} position="bottom" />
      </CollectionAudio>
    ) : (
      <section class="empty-state">
        <h2>Khung đã sẵn, corpus chưa được nhập.</h2>
        <p>Không phát minh UID/hierarchy cho bộ này. Catalog sẽ được import từ canonical SuttaCentral tree khi Trung Bộ đạt gate chất lượng.</p>
      </section>
    )}
  </main>
</Base>
