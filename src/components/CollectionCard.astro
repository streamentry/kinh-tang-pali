---
import type { CollectionDefinition } from '../lib/canon/types';
import { withBase } from '../lib/url';
interface Props {
  collection: CollectionDefinition;
  total: number;
  started: number;
  published: number;
}
const { collection, total, started, published } = Astro.props;
---
<a class:list={['collection-card', collection.code === 'mn' && 'priority']} href={withBase(`sutta/${collection.code}/`)}>
  <div class="eyebrow" aria-hidden="true">{collection.code.toUpperCase()}</div>
  <div class="collection-card-content">
  <h3>{collection.titleVi}</h3>
  <p class="pali-title">{collection.titlePali}</p>
  <p>{collection.description}</p>
  {total > 0 ? (
    <div class="progress-line">
      <span>{published}/{total} đã xuất bản</span>
      <span>{started}/{total} đã bắt đầu</span>
    </div>
  ) : (
    <div class="progress-line"><span>Chưa có bài</span></div>
  )}
  </div>
</a>
