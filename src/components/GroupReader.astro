---
/**
 * Continuous reading of one part of a group: its texts one after another, each in its own
 * comparison shell with its own heading, UID, status and closed versions.
 *
 * Every segment appears once, with the same id as on its text's own page (segment IDs carry the
 * text's UID, so they never collide across texts), and its number links back to that page. One
 * toolbar drives every shell. A text without a project translation stays in "Bốn bản" when the
 * reader picks "Chỉ Việt", as on its own page. Whole-text references are listed once per pinned
 * source file — a bundle such as `an1.1-10` is one entry, not ten.
 */
import type { CanonLayerSummary, CollectionCode, LayerAbsenceReason } from '../lib/canon/types';
import type { ReadingEntry } from '../lib/canon/reading-budget';
import { composeDocument } from '../lib/canon/document';
import { creditForReference, externalReferences, legacyKeyFor, pageUrlFor } from '../lib/canon/external';
import { loadLegacyVi } from '../lib/canon/legacy-vi';
import { listCollection } from '../lib/canon/load';
import { STATUS_LABEL } from '../lib/canon/status-label';
import { withBase } from '../lib/url';
import SegmentRows from './SegmentRows.astro';

interface Props { code: CollectionCode; entries: ReadingEntry[] }
const { code, entries } = Astro.props;
const titles = new Map(listCollection(code).map((item) => [item.uid, item.title]));
const pageOf = (uid: string) => withBase(`sutta/${code}/${uid}/`);

const ORDER = ['pali', 'english', 'viCurrent', 'vi'] as const;
const STANDING: Record<CanonLayerSummary['standing'], string> = { authority: 'Nguồn chuẩn', reference: 'Tham khảo', project: 'Bản của dự án' };
const ABSENT: Record<LayerAbsenceReason, string> = {
  none: '',
  'not-published-upstream': 'bản chụp không có',
  'not-synced': 'chưa tải về cache',
  'not-started': 'chưa có nội dung',
};

const texts = entries.map((entry) => {
  if (entry.type === 'link') return { entry, document: undefined };
  return { entry, document: composeDocument(code, entry.uid) };
});
const prepared = texts.map(({ entry, document }) => {
  if (!document) return { entry };
  const shown = ORDER.map((key) => document.layers.find((layer) => layer.id === key)).filter((layer): layer is CanonLayerSummary => Boolean(layer));
  const closed = shown.filter((layer) => layer.reason !== 'none');
  const hasVi = Boolean(shown.find((layer) => layer.id === 'vi' && layer.withText > 0));
  return { entry, document, shown, closed, open: shown.length - closed.length, initialMode: hasVi ? 'vi' : 'compare' };
});
const anyVi = prepared.some((item) => 'initialMode' in item && item.initialMode === 'vi');

/** One whole-text reference per pinned source file, credited per text as the reader does. */
const lookups = new Map<string, { uids: string[]; items: Array<{ title: string; credit: string; url: string }> }>();
for (const { entry, document } of texts) {
  if (!document) continue;
  const existing = lookups.get(document.sourceKey);
  if (existing) { existing.uids.push(document.uid); continue; }
  const items = externalReferences()
    .filter((reference) => reference.collections.includes(code) && reference.localCopy === 'legacyHtml')
    .flatMap((reference) => {
      const url = pageUrlFor(reference, document.uid, code, document.sourceKey);
      const key = url ? legacyKeyFor(reference, document.uid, code, document.sourceKey) : null;
      return url && key && loadLegacyVi(key) ? [{ title: reference.title, credit: creditForReference(reference), url }] : [];
    });
  lookups.set(document.sourceKey, { uids: [entry.uid], items });
}
/** Links grouped under each distinct credit, so a phẩm of ten texts by one translator names them once. */
const byCredit = new Map<string, Array<{ sourceKey: string; uids: string[] }>>();
for (const [sourceKey, value] of lookups) {
  for (const reference of value.items) {
    const list = byCredit.get(reference.credit) ?? [];
    list.push({ sourceKey, uids: value.uids });
    byCredit.set(reference.credit, list);
  }
}
---
<div class="group-reader" data-pagefind-ignore>
  <div class="reader-toolbar group-reader-toolbar">
    <div class="mode-switch" role="group" aria-label="Chế độ hiển thị cho cả trang">
      <button type="button" data-group-mode="compare" class:list={[!anyVi && 'active']} aria-pressed={anyVi ? 'false' : 'true'}>Bốn bản</button>
      <button type="button" data-group-mode="interlinear" aria-pressed="false">Đối chiếu</button>
      <button type="button" data-group-mode="vi" class:list={[anyVi && 'active']} aria-pressed={anyVi ? 'true' : 'false'} disabled={!anyVi}>Chỉ Việt</button>
    </div>
    <div class="text-size" role="group" aria-label="Cỡ chữ kinh văn" hidden>
      <button type="button" data-size-step="-1" aria-label="Giảm cỡ chữ" title="Giảm cỡ chữ"><span aria-hidden="true">A−</span></button>
      <output class="text-size-value" aria-live="polite">100%</output>
      <button type="button" data-size-step="1" aria-label="Tăng cỡ chữ" title="Tăng cỡ chữ"><span aria-hidden="true">A+</span></button>
    </div>
  </div>

  {prepared.map((item) => {
    const uid = item.entry.uid;
    const headingId = `doc-${uid.replace(/[^a-z0-9-]/gi, '-')}`;
    if (!('document' in item) || !item.document) {
      return (
        <section class="group-text is-linked" aria-labelledby={headingId}>
          <header class="group-text-head">
            <p class="eyebrow"><span class="uid">{uid.toUpperCase()}</span></p>
            <h2 id={headingId}><a href={pageOf(uid)}>{titles.get(uid) ?? uid.toUpperCase()}</a></h2>
            <p class="group-text-note">Bài này dài ({item.entry.segments} đoạn Pāli), vượt khuôn một trang đọc liên tục, nên không chép vào đây. <a href={pageOf(uid)}>Đọc ở trang riêng →</a></p>
          </header>
        </section>
      );
    }
    const { document, shown, closed, open, initialMode } = item;
    return (
      <section class="group-text" aria-labelledby={headingId}>
        <header class="group-text-head">
          <p class="eyebrow"><span class="uid">{uid.toUpperCase()}</span></p>
          <h2 id={headingId}><a href={pageOf(uid)}>{document.viTitle}</a></h2>
          <p class="group-text-note">
            <span class:list={['status', document.hasProjectData ? document.status : 'not-started']}>{STATUS_LABEL[document.hasProjectData ? document.status : 'not-started'] ?? document.status}</span>
            {' '}{document.segments.length} đoạn Pāli
            {closed.length > 0 && <> · Vắng: {closed.map((layer) => `${layer.title} (${ABSENT[layer.reason]})`).join(', ')}</>}
            {' '}· <a href={pageOf(uid)}>Trang bài, nguồn và lịch sử biên tập</a>
          </p>
        </header>
        <div class="reader-shell" data-reader-mode={initialMode} data-initial-mode={initialMode} data-open-columns={open} data-closed={closed.map((layer) => layer.id).join(' ') || undefined}
          aria-label={`So sánh ${shown.length} bản của ${uid.toUpperCase()}`}>
          <div class="segments">
            <div class="segments-head" aria-hidden="true">
              <span class="head-id">Đoạn</span>
              {shown.map((layer) => (
                <span class:list={['head-cell', `head-${layer.id}`, `standing-${layer.standing}`]}>{layer.title}<small>{STANDING[layer.standing]}</small></span>
              ))}
            </div>
            <SegmentRows segments={document.segments} href={(segmentId) => `${pageOf(uid)}#${segmentId}`} />
          </div>
        </div>
      </section>
    );
  })}

  {byCredit.size > 0 && (
    <section class="group-lookups" aria-labelledby="tra-cuu-nhom">
      <h2 id="tra-cuu-nhom">Tra cứu toàn văn</h2>
      <p class="refs-hint">
        Bản Việt nguyên bài không phải cột đối chiếu và không chép lại ở đây. Mỗi tệp nguồn được
        liệt kê một lần; toàn văn đọc ở trang bài, mục Tra cứu toàn văn.
      </p>
      {[...byCredit.entries()].map(([credit, sources]) => (
        <>
          <p class="ref-credit">{credit}</p>
          <ul>
            {sources.map(({ sourceKey, uids }) => (
              <li><a href={`${pageOf(uids[0])}#tra-cuu-toan-van`}>{uids.length > 1 ? `${uids[0].toUpperCase()}–${uids[uids.length - 1].toUpperCase()} (tệp gộp ${sourceKey})` : uids[0].toUpperCase()}</a></li>
            ))}
          </ul>
        </>
      ))}
    </section>
  )}
</div>

<script is:inline>
  /**
   * One toolbar for every text of the page. Presentation only: every version stays in the
   * markup. A text whose project translation is absent keeps "Bốn bản" under "Chỉ Việt",
   * because its Pāli must stay readable.
   */
  document.querySelectorAll('.group-reader').forEach((root) => {
    const shells = Array.from(root.querySelectorAll('.reader-shell'));
    const buttons = Array.from(root.querySelectorAll('[data-group-mode]'));
    const setMode = (mode) => {
      shells.forEach((shell) => {
        const closedVi = (shell.getAttribute('data-closed') || '').split(' ').includes('vi');
        shell.setAttribute('data-reader-mode', mode === 'vi' && closedVi ? 'compare' : mode);
      });
      buttons.forEach((button) => {
        const active = button.getAttribute('data-group-mode') === mode;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
    };
    buttons.forEach((button) => button.addEventListener('click', () => setMode(button.getAttribute('data-group-mode'))));

    const SIZE_KEY = 'kinh-tang-pali:reader:text-size:v1';
    const SIZES = [0.9, 1, 1.1, 1.2, 1.35];
    const sizeGroup = root.querySelector('.text-size');
    if (sizeGroup) sizeGroup.hidden = false;
    const sizeValue = root.querySelector('.text-size-value');
    const sizeButtons = Array.from(root.querySelectorAll('[data-size-step]'));
    let sizeIndex = 1;
    try { sizeIndex = Math.min(SIZES.length - 1, Math.max(0, Number(localStorage.getItem(SIZE_KEY) ?? 1))); } catch { sizeIndex = 1; }
    const applySize = () => {
      shells.forEach((shell) => shell.style.setProperty('--reader-scale', String(SIZES[sizeIndex])));
      if (sizeValue) sizeValue.textContent = `${Math.round(SIZES[sizeIndex] * 100)}%`;
      sizeButtons.forEach((button) => {
        const step = Number(button.getAttribute('data-size-step'));
        button.disabled = step < 0 ? sizeIndex === 0 : sizeIndex === SIZES.length - 1;
      });
    };
    sizeButtons.forEach((button) => button.addEventListener('click', () => {
      sizeIndex = Math.min(SIZES.length - 1, Math.max(0, sizeIndex + Number(button.getAttribute('data-size-step'))));
      try { localStorage.setItem(SIZE_KEY, String(sizeIndex)); } catch { /* Size still applies for this visit. */ }
      applySize();
    }));
    applySize();
  });
</script>
