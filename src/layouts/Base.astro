---
import { withBase } from '../lib/url';
import { creditSummary } from '../lib/canon/tooling';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title = 'Kinh Tạng Pāli Việt',
  description = 'Đọc Kinh tạng Pāli tiếng Việt, đối chiếu từng đoạn với Pāli và bản English. Tra cứu năm bộ Nikāya, nguồn văn bản và lịch sử biên tập.',
  noindex = false,
} = Astro.props;

const assistance = creditSummary();
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const pageSchema = {
  '@context': 'https://schema.org', '@type': 'WebPage',
  '@id': canonical, url: canonical, name: title, description, inLanguage: 'vi',
  isPartOf: { '@type': 'WebSite', name: 'Kinh Tạng Pāli Việt', url: new URL(withBase(), Astro.site).href },
};
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="Lê Việt Hồng (Cư Sĩ Chánh Niệm)" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="Ydzx5wL5Yz9xT3ASFAU_l67uQgb5iIQBITZJjuA2EAE" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Kinh Tạng Pāli Việt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema).replace(/</g, '\\u003c')} />
    <link rel="stylesheet" href={withBase('styles/global.css')} />
  </head>
  <body>
    <header class="site-header" data-pagefind-ignore>
      <a class="brand" href={withBase()}>Kinh Tạng Pāli Việt</a>
      <nav aria-label="Điều hướng chính">
        <a href={withBase('sutta/mn/')}>Trung Bộ</a>
        <a href={withBase('search/')}>Tìm kiếm</a>
        <a href={withBase('credits/')}>Nguồn</a>
        <a href="https://github.com/streamentry/kinh-tang-pali" target="_blank" rel="noopener noreferrer">Đóng góp</a>
        <a class="button feedback-button" href="https://github.com/streamentry/kinh-tang-pali/issues/new?template=gop-y.md" target="_blank" rel="noopener noreferrer">Góp ý chỉnh sửa</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer" data-pagefind-ignore>
      <span>
        Dự án & biên tập: Lê Việt Hồng (Cư Sĩ Chánh Niệm) · Pāli: SuttaCentral Mahāsaṅgīti
        (phạm vi công cộng) · tham khảo: Bhikkhu Sujato, HT. Thích Minh Châu — bản quyền thuộc
        dịch giả · hỗ trợ: {assistance} ·
        <a href="https://streamentry.github.io/streamentry/" target="_blank" rel="noopener noreferrer">Hướng Đến Nhập Lưu</a> ·
        <a href={withBase('credits/')}>Nguồn, giấy phép & ghi công</a> ·
        <a href="mailto:tostreamentry@gmail.com">Liên hệ / hỗ trợ</a> ·
        <a href="https://github.com/streamentry/kinh-tang-pali" target="_blank" rel="noopener noreferrer">Đóng góp trên GitHub</a>
      </span>
    </footer>
  </body>
</html>
