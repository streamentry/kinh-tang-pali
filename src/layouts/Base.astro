---
import { withBase } from '../lib/url';
import { creditSummary } from '../lib/canon/tooling';
import BrandMark from '../components/BrandMark.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Absolute URL of a social preview image, with its alt text. */
  image?: { url: string; alt: string };
}
const {
  title = 'Kinh Tạng Pāli Việt',
  description = 'Đọc Kinh tạng Pāli tiếng Việt, đối chiếu từng đoạn với Pāli và bản English. Tra cứu năm bộ Nikāya, nguồn văn bản và lịch sử biên tập.',
  noindex = false,
  image,
} = Astro.props;

const assistance = creditSummary();
const navigation = [
  { label: 'Trung Bộ', path: 'sutta/mn/' },
  { label: 'Tìm kiếm', path: 'search/' },
  { label: 'Nguồn', path: 'credits/' },
  { label: 'Chất lượng', path: 'quality/' },
];
const activePath = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (path: string) => activePath === withBase(path).replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const pageSchema = {
  '@context': 'https://schema.org', '@type': 'WebPage',
  '@id': canonical, url: canonical, name: title, description, inLanguage: 'vi',
  isPartOf: { '@type': 'WebSite', name: 'Kinh Tạng Pāli Việt', url: new URL(withBase(), Astro.site).href },
};
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="Lê Việt Hồng (Cư Sĩ Chánh Niệm)" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="Ydzx5wL5Yz9xT3ASFAU_l67uQgb5iIQBITZJjuA2EAE" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="Kinh Tạng Pāli Việt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image.url} />}
    {image && <meta property="og:image:alt" content={image.alt} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(pageSchema).replace(/</g, '\\u003c')} />
    <link rel="icon" href={withBase('favicon.ico')} type="image/x-icon" sizes="16x16 32x32" />
    <link rel="icon" href={withBase('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} sizes="180x180" />
    <link rel="stylesheet" href={withBase('styles/fonts.css')} />
    <link rel="stylesheet" href={withBase('styles/tokens.css')} />
    <link rel="stylesheet" href={withBase('styles/global.css')} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Đến nội dung chính</a>
    <header class="site-header" data-pagefind-ignore>
      <a class="brand" href={withBase()} aria-label="Kinh Tạng Pāli Việt · Trang chủ">
        <BrandMark />
        <span class="brand-copy">
          <span class="brand-name">Kinh Tạng Pāli Việt</span>
          <span class="brand-note">Đọc &amp; đối chiếu kinh văn</span>
        </span>
      </a>
      <nav aria-label="Điều hướng chính">
        {navigation.map(item => (
          <a href={withBase(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.label}</a>
        ))}
        <a class="button feedback-button" href="https://github.com/streamentry/kinh-tang-pali/issues/new?template=gop-y.md" target="_blank" rel="noopener noreferrer">Góp ý chỉnh sửa</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer" data-pagefind-ignore>
      <div class="footer-heading">
        <span class="footer-brand"><BrandMark class="brand-mark" /><strong>Kinh Tạng Pāli Việt</strong></span>
        <nav aria-label="Liên kết cuối trang">
          <a href={withBase('credits/')}>Nguồn &amp; giấy phép</a>
          <a href="https://streamentry.github.io/streamentry/" target="_blank" rel="noopener noreferrer">Hướng Đến Nhập Lưu</a>
          <a href="mailto:tostreamentry@gmail.com">Liên hệ / hỗ trợ</a>
          <a href="https://github.com/streamentry/kinh-tang-pali" target="_blank" rel="noopener noreferrer">Đóng góp trên GitHub</a>
        </nav>
      </div>
      <p class="footer-credit">
        Dự án &amp; biên tập: Lê Việt Hồng (Cư Sĩ Chánh Niệm). Pāli: SuttaCentral Mahāsaṅgīti
        (phạm vi công cộng). Tham khảo: Bhikkhu Sujato, HT. Thích Minh Châu; bản quyền thuộc
        dịch giả. Hỗ trợ: {assistance}.
      </p>
    </footer>
  </body>
</html>
