---
import Base from '../../../layouts/Base.astro';
import QualityHistory from '../../../components/QualityHistory.astro';
import SuttaReader from '../../../components/SuttaReader.astro';
import { COLLECTIONS, loadCatalog, loadMeta } from '../../../lib/canon/load';
import { composeDocument } from '../../../lib/canon/document';
import { loadAssessmentHistory } from '../../../lib/canon/quality';
import type { CollectionCode, TranslationQualityAssessment } from '../../../lib/canon/types';
import { withBase } from '../../../lib/url';

export function getStaticPaths() {
  return COLLECTIONS.flatMap((collection) => {
    const catalog = loadCatalog(collection.code);
    return catalog.texts.map((item) => ({
      params: { collection: collection.code, uid: item.uid },
      props: { collection, uid: item.uid },
    }));
  });
}

const { collection, uid } = Astro.props;
const document = composeDocument(collection.code as CollectionCode, uid);
const meta = loadMeta(collection.code, uid);
const history = loadAssessmentHistory(collection.code, uid);
const selectedIsSaved = Boolean(meta?.quality?.assessment_id && history.assessments.some(entry => entry.id === meta?.quality?.assessment_id));
const legacyScores = [history.legacy_quality, selectedIsSaved ? undefined : meta?.quality]
  .filter((quality): quality is TranslationQualityAssessment => Boolean(quality))
  .filter((quality, index, all) => all.findIndex(item => JSON.stringify(item) === JSON.stringify(quality)) === index);
const supportsSummary = ['mn', 'dn'].includes(collection.code);
const hasSummary = supportsSummary && Boolean(document.summary);
const statusLabel = document.hasProjectData ? document.status : 'not-started';
const summaryParagraphs = (document.summary ?? '').split(/\n{2,}/).filter((para) => para.trim() !== '');
---
<Base title={`${document.viTitle} · ${uid.toUpperCase()}`}>
  <main class="page reader-page">
    <a class="back-link" href={withBase(`sutta/${collection.code}/`)}>← {collection.titleVi}</a>
    <header class="sutta-header">
      <div class="sutta-identity">
        <p class="eyebrow">{uid.toUpperCase()} · {collection.titlePali}</p>
        <h1 data-pagefind-meta="title">{document.viTitle}</h1>
        {document.paliTitle && <p class="pali-title large" lang="pi">{document.paliTitle}</p>}
      </div>
      <span class:list={['status', statusLabel]}>{statusLabel}</span>
    </header>
    <p class="provenance-line" data-pagefind-ignore>
      Pāli đọc tại bilara commit <code>{document.commit.slice(0, 12)}</code> · 4 bản: Pāli,
      English, Việt hiện hành, Việt dự án
    </p>
    {document.status !== 'published' && document.hasProjectData && (
      <div class="editorial-banner" data-pagefind-ignore>
        Bản này đang ở trạng thái <strong>{document.status}</strong>, chưa phải bản phát hành cuối.
      </div>
    )}
    {document.summary && (
      <section class="sutta-summary" data-pagefind-body>
        <h2>Tóm tắt &amp; diễn giải</h2>
        {summaryParagraphs.map((para) => <p>{para}</p>)}
        <p class="summary-note" data-pagefind-ignore>
          Phần tóm tắt do dự án biên soạn để hỗ trợ đọc, không phải kinh văn. Bản Pāli và các
          bản dịch hiển thị bên dưới mới là nội dung có thẩm quyền.
        </p>
      </section>
    )}
    {supportsSummary && !hasSummary && <p data-pagefind-ignore>Chưa có nội dung tóm tắt cho bài kinh này.</p>}
    {supportsSummary && <QualityHistory collection={collection.code} uid={uid} target="summary" assessments={history.assessments} />}
    {document.hasProjectData && <QualityHistory collection={collection.code} uid={uid} target="translation" assessments={history.assessments} legacy={legacyScores} />}
    <SuttaReader document={document} />
  </main>
</Base>
