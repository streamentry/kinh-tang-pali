---
import Base from '../layouts/Base.astro';
const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
---
<Base noindex title="Tìm kiếm · Kinh Tạng Pāli Việt">
  <main id="main-content" tabindex="-1" class="page search-page">
    <p class="eyebrow">Tra cứu kinh văn</p>
    <h1>Tìm trong kinh văn</h1>
    <form id="search-form" class="search-form" role="search">
      <label class="visually-hidden" for="search-input">Từ khóa tìm kiếm</label>
      <input id="search-input" type="search" placeholder="Nhập tiếng Việt, Pāli, English hoặc UID…" autocomplete="off" />
      <button class="button primary" type="submit">Tìm</button>
    </form>
    <fieldset class="version-filter" id="version-filter">
      <legend>Tìm trong bản nào</legend>
      <label><input type="checkbox" name="version" value="Pāli" checked /> Pāli <span class="hint">nguồn chuẩn</span></label>
      <label><input type="checkbox" name="version" value="English" checked /> English <span class="hint">tham khảo</span></label>
      <label><input type="checkbox" name="version" value="Việt hiện hành" checked /> Việt hiện hành <span class="hint">tham khảo</span></label>
      <label><input type="checkbox" name="version" value="Việt 2026" checked /> Việt 2026 <span class="hint">bản canonical</span></label>
      <p class="hint filter-hint">
        Mỗi bài kinh hiển thị bốn bản. Chỉ giữ chọn bản bạn muốn tìm — hữu ích khi bạn
        đang tra thuật ngữ trong một bản tham khảo mà không muốn kết quả lẫn bản dịch của dự án.
      </p>
    </fieldset>
    <div id="search-status" class="search-status" aria-live="polite"></div>
    <section id="group-results-section" class="group-results-section" aria-labelledby="group-results-heading" hidden>
      <h2 id="group-results-heading">Nhóm kinh</h2>
      <ol id="group-results" class="search-results group-results"></ol>
    </section>
    <h2 id="text-results-heading" class="visually-hidden">Bài kinh</h2>
    <ol id="search-results" class="search-results" aria-labelledby="text-results-heading"></ol>
  </main>
</Base>

<script type="module" define:vars={{ baseUrl }}>
  const form = document.getElementById('search-form');
  const input = document.getElementById('search-input');
  const status = document.getElementById('search-status');
  const results = document.getElementById('search-results');
  const groupSection = document.getElementById('group-results-section');
  const groupResults = document.getElementById('group-results');
  const versionFilter = document.getElementById('version-filter');
  let pagefind;

  function withBase(path) {
    if (/^https?:\/\//.test(path)) return path;
    if (path === baseUrl.slice(0, -1) || path.startsWith(baseUrl)) return path;
    return `${baseUrl}${path.replace(/^\/+/, '')}`;
  }

  async function ensurePagefind() {
    if (!pagefind) {
      pagefind = await import(`${baseUrl}pagefind/pagefind.js`);
      await pagefind.init();
    }
    return pagefind;
  }

  /**
   * Scope a search to the chosen versions.
   *
   * Every text now carries four versions in its markup, all of them indexed — nothing is
   * hidden from search, because hiding a version would make it undiscoverable. But that
   * means a Pāli query and an English query both land on the same text, so the result
   * says which versions the text has and lets the reader narrow the scope themselves.
   */
  function selectedVersions() {
    return Array.from(versionFilter.querySelectorAll('input[name="version"]:checked')).map(
      (box) => box.value,
    );
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const query = input.value.trim();
    const versions = selectedVersions();
    results.replaceChildren();
    groupResults.replaceChildren();
    groupSection.hidden = true;
    if (!query) {
      status.textContent = 'Nhập từ khóa để tìm.';
      return;
    }
    if (versions.length === 0) {
      status.textContent = 'Chọn ít nhất một bản để tìm.';
      return;
    }

    status.textContent = 'Đang tìm…';
    try {
      const pf = await ensurePagefind();
      // Groups (thiên, tương ưng, chương, phẩm, tác phẩm) are their own result type. Only their
      // names are indexed, so a group never repeats the scripture its texts already return.
      const [search, groups] = await Promise.all([
        pf.search(query, { filters: { version: versions } }),
        pf.search(query, { filters: { type: 'Nhóm' } }),
      ]);
      const scope = versions.length === 4 ? 'cả 4 bản' : versions.join(', ');
      const shownGroups = Math.min(groups.results.length, 10);
      const groupNote = groups.results.length
        ? ` · ${groups.results.length} nhóm kinh${groups.results.length > shownGroups ? ` (hiện ${shownGroups} nhóm đầu)` : ''}`
        : '';
      status.textContent = search.results.length
        ? `${search.results.length} kết quả · tìm trong ${scope}${groupNote}`
        : `Không có kết quả trong ${scope}${groupNote}.`;
      const groupData = await Promise.all(groups.results.slice(0, 10).map((result) => result.data()));
      for (const item of groupData) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = withBase(item.url);
        const h3 = document.createElement('h3');
        h3.textContent = item.meta?.title || item.url;
        const trail = document.createElement('p');
        trail.className = 'result-trail';
        trail.textContent = item.meta?.trail || '';
        a.append(h3, trail);
        li.append(a);
        groupResults.append(li);
      }
      groupSection.hidden = groupData.length === 0;
      const data = await Promise.all(search.results.slice(0, 30).map((result) => result.data()));
      for (const item of data) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = withBase(item.url);
        const h2 = document.createElement('h2');
        h2.textContent = item.meta?.title || item.url;
        const excerpt = document.createElement('p');
        excerpt.innerHTML = item.excerpt || '';
        // Say which versions the page actually offers, so a result is never read as
        // "this text says this in Vietnamese" when the match was in the English column.
        const available = Array.isArray(item.filters?.version) ? item.filters.version : [];
        const meta = document.createElement('p');
        meta.className = 'result-versions';
        meta.textContent = available.length
          ? `Bản có trong trang: ${available.join(' · ')}`
          : '';
        const trail = document.createElement('p');
        trail.className = 'result-trail';
        trail.textContent = item.meta?.trail || '';
        a.append(h2, trail, excerpt, meta);
        li.append(a);
        results.append(li);
      }
    } catch (error) {
      console.error(error);
      status.textContent = 'Chưa tải được dữ liệu tìm kiếm. Vui lòng thử lại sau.';
    }
  });
</script>
