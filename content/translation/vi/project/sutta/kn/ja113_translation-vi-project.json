{
  "ja113:0.1": "Jātaka",
  "ja113:0.2": "Bộ Một Bài Kinh",
  "ja113:0.3": "Phẩm Haṁci",
  "ja113:0.4": "3. Kinh Chó Rừng",
  "ja113:1.1": "“Ngươi đã tin con chó rừng,",
  "ja113:1.2": "say rượu, này Bà-la-môn;",
  "ja113:1.3": "Đến một trăm vỏ sò còn không có,",
  "ja113:1.4": "lấy đâu ra hai trăm đồng tiền.”",
  "ja113:2.1": "Kinh Chó Rừng, thứ ba."
}
