{
  "ja104:0.1": "Jātaka",
  "ja104:0.2": "Bộ Một Bài Kinh",
  "ja104:0.3": "Phẩm Parosata",
  "ja104:0.4": "4. Kinh Mittavinda",
  "ja104:1.1": "“Bốn thì đi tới tám,",
  "ja104:1.2": "tám rồi mười sáu;",
  "ja104:1.3": "mười sáu rồi ba mươi hai,",
  "ja104:1.4": "đo không hết vòng xoay của bánh xe;",
  "ja104:1.5": "Kẻ ham tích lũy,",
  "ja104:1.6": "bánh xe cứ xoay trên trục nó”ti.",
  "ja104:2.1": "Kinh Mittavinda thứ bốn."
}
