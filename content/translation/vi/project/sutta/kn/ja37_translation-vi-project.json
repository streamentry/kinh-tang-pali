{
  "ja37:0.1": "Jātaka",
  "ja37:0.2": "Bộ Một Bài Kinh",
  "ja37:0.3": "Phẩm Chim Đang Lồng",
  "ja37:0.4": "7. Kinh Chim Tittira",
  "ja37:1.1": "“Ai kính trọng người lớn tuổi,",
  "ja37:1.2": "là kẻ hiểu biết pháp;",
  "ja37:1.3": "được ca ngợi ngay trong đời này,",
  "ja37:1.4": "còn đời sau là nẻo lành.”",
  "ja37:2.1": "Kinh Chim Tittira, thứ bảy."
}
