{
  "ja114:0.1": "Jātaka",
  "ja114:0.2": "Bộ Một Bài Kinh",
  "ja114:0.3": "Phẩm Haṁci",
  "ja114:0.4": "4. Kinh Mitacintī",
  "ja114:1.1": "“Bahucintī và Appacintī,",
  "ja114:1.2": "cả hai mắc vào lưới;",
  "ja114:1.3": "Mitacintī đã thả cả hai ra,",
  "ja114:1.4": "cả hai gặp lại nhau ở đó.”",
  "ja114:2.1": "Kinh Mitacintī, thứ tư."
}
