{
  "ja106:0.1": "Jātaka",
  "ja106:0.2": "Bộ Một Bài Kinh",
  "ja106:0.3": "Phẩm Parosata",
  "ja106:0.4": "6. Kinh Udañcanījātaka",
  "ja106:1.1": "“Trong lúc ta sống yên vui,",
  "ja106:1.2": "Udañcanī lo việc nấu ăn;",
  "ja106:1.3": "lại là kẻ trộm mang danh vợ,",
  "ja106:1.4": "đi xin dầu và muối.”.",
  "ja106:2.1": "Kinh Udañcanījātaka thứ sáu."
}
