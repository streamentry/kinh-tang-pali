{
  "ja242:0.1": "Jātaka",
  "ja242:0.2": "Bộ Một Bài Kinh",
  "ja242:0.3": "Phẩm Siṅgāla",
  "ja242:0.4": "2. Kinh Con Chó",
  "ja242:1.1": "“Ngu dốt thay, bạn chó,",
  "ja242:1.2": "kẻ không cắn kẻ phá nhà;",
  "ja242:1.3": "Nên tháo xích cho hắn,",
  "ja242:1.4": "cho ăn no rồi bảo hắn về nhà”.",
  "ja242:2.1": "“Ý tôi đã nghĩ đến,",
  "ja242:2.2": "trong lòng tôi đã làm;",
  "ja242:2.3": "Tôi chờ đợi thời khắc,",
  "ja242:2.4": "khi người ta trở nên mù”ti.",
  "ja242:3.1": "Kinh Con Chó thứ hai."
}
