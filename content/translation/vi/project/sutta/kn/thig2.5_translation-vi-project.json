{
  "thig2.5:0.1": "Therīgāthā 2.5",
  "thig2.5:0.2": "Bộ Hai Bài Kinh",
  "thig2.5:0.3": "Kinh Kệ Của Trưởng Lão Nữ Cittā",
  "thig2.5:1.1": "“Dù cho tôi gầy,",
  "thig2.5:1.2": "ốm đau, yếu ốt lắm;",
  "thig2.5:1.3": "chống gậy mà bước đi,",
  "thig2.5:1.4": "leo lên tận núi cao.",
  "thig2.5:2.1": "Tôi đặt y ngoài xuống,",
  "thig2.5:2.2": "lật ngược cả cái bát;",
  "thig2.5:2.3": "dựa vào một tảng đá,",
  "thig2.5:2.4": "phá vỡ khối tối tăm”ti.",
  "thig2.5:3.1": "… Trưởng lão nữ Cittā …."
}
