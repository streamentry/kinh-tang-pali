{
  "ja55:0.1": "Jātaka",
  "ja55:0.2": "Bộ Một Bài Kinh",
  "ja55:0.3": "Phẩm Hy Vọng",
  "ja55:0.4": "5. Kinh Ngũ Binh",
  "ja55:1.1": "“Người có tâm không bị vướng,",
  "ja55:1.2": "có ý không bị vướng;",
  "ja55:1.3": "trau dồi thiện pháp,",
  "ja55:1.4": "để mong đạt sự an ổn, thoát khỏi gông trói;",
  "ja55:1.5": "sẽ tuần tự đạt đến",
  "ja55:1.6": "sự tận diệt mọi kiết sử.”",
  "ja55:2.1": "Kinh Ngũ Binh thứ năm."
}
