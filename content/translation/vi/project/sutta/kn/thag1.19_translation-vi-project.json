{
  "thag1.19:0.1": "Theragāthā 1.19",
  "thag1.19:0.2": "Bộ Một Bài Kinh",
  "thag1.19:0.3": "Phẩm Thứ Hai",
  "thag1.19:0.4": "Kinh Kệ Của Trưởng Lão Kula",
  "thag1.19:1.1": "“Người trị thủy dẫn nước,",
  "thag1.19:1.2": "thợ tên uốn mũi tên,",
  "thag1.19:1.3": "thợ mộc uốn gỗ,",
  "thag1.19:1.4": "người giữ hạnh lành tự điều phục mình”ti.",
  "thag1.19:1.5": "… Trưởng lão Kula …."
}
