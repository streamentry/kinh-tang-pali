{
  "ja155:0.1": "Jātaka",
  "ja155:0.2": "Nhóm Hai Kệ",
  "ja155:0.3": "Phẩm Kiên Cố",
  "ja155:0.4": "5. Kinh Bhagga",
  "ja155:1.1": "“Hãy sống trăm năm, Bhagga,",
  "ja155:1.2": "và thêm hai mươi năm nữa;",
  "ja155:1.3": "Mong quỷ đừng ăn ta,",
  "ja155:1.4": "ngươi hãy sống trăm mùa thu”.",
  "ja155:2.1": "“Ngươi cũng hãy sống trăm năm,",
  "ja155:2.2": "và thêm hai mươi năm nữa;",
  "ja155:2.3": "Mong quỷ ăn thuốc độc,",
  "ja155:2.4": "ngươi hãy sống trăm mùa thu.”",
  "ja155:3.1": "Kinh Bhagga, thứ năm."
}
