{
  "thag1.113:0.1": "Theragāthā 1.113",
  "thag1.113:0.2": "Bộ Một Bài Kinh",
  "thag1.113:0.3": "Phẩm Thứ Mười Hai",
  "thag1.113:0.4": "Kinh Kệ Của Trưởng Lão Vanavaccha",
  "thag1.113:1.1": "“Nước trong vắt, đá rộng bằng;",
  "thag1.113:1.2": "đầy khỉ và hươu nai,",
  "thag1.113:1.3": "phủ kín rêu ướt sương,",
  "thag1.113:1.4": "những vách đá ấy làm tôi vui lòng.”",
  "thag1.113:1.5": "… Trưởng lão Vanavaccha …. "
}
