{
  "ja82:0.1": "Jātaka",
  "ja82:0.2": "Nhóm Một Kệ",
  "ja82:0.3": "Phẩm Chúng Tôi Đã Uống",
  "ja82:0.4": "2. Kinh Mittavindaka",
  "ja82:1.1": "“Đã vượt qua Ramaṇaka,",
  "ja82:1.2": "cùng Sadāmatta và Dūbhaka;",
  "ja82:1.3": "ngươi đang ngồi trên đá,",
  "ja82:1.4": "vì khi còn sống ngươi sẽ không được thoát.”",
  "ja82:2.1": "Kinh Mittavindaka, thứ hai."
}
