{
  "ja145:0.1": "Jātaka",
  "ja145:0.2": "Bộ Một Bài Kinh",
  "ja145:0.3": "Phẩm Kakaṇṭaka",
  "ja145:0.4": "5. Kinh Rādha",
  "ja145:1.1": "“Này Rādha, ngươi không biết rằng",
  "ja145:1.2": "nửa đêm còn chưa đến;",
  "ja145:1.3": "Ngươi kêu than không ngớt,",
  "ja145:1.4": "— kẻ đã chán chê tổ chim cú”.",
  "ja145:2.1": "Kinh Rādha thứ năm."
}
