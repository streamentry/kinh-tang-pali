{
  "thag1.55:0.1": "Theragāthā 1.55",
  "thag1.55:0.2": "Bộ Một Bài Kinh",
  "thag1.55:0.3": "Phẩm Thứ Sáu",
  "thag1.55:0.4": "Kinh Kệ Của Trưởng Lão Añjanavaniya",
  "thag1.55:1.1": "“Tự dựng một túp lều lá,",
  "thag1.55:1.2": "rồi bước vào rừng Añjana;",
  "thag1.55:1.3": "Tôi đã chứng ngộ tam-minh,",
  "thag1.55:1.4": "đã làm tròn lời dạy của Đức Phật.”",
  "thag1.55:1.5": "… Trưởng lão Añjanavaniyo …."
}
