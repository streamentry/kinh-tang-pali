{
  "ja97:0.1": "Jātaka",
  "ja97:0.2": "Nhóm Một Kệ",
  "ja97:0.3": "Phẩm Litta",
  "ja97:0.4": "7. Kinh Nāmasiddhi",
  "ja97:1.1": "“Thấy Jīvaka đã chết,",
  "ja97:1.2": "Dhanapāla nghèo khổ,",
  "ja97:1.3": "Panthaka lạc giữa rừng,",
  "ja97:1.4": "Pāpaka đã trở về lại.”",
  "ja97:2.1": "Kinh Nāmasiddhi, thứ bảy."
}
