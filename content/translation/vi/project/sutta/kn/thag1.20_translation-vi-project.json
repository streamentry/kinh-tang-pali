{
  "thag1.20:0.1": "Theragāthā 1.20",
  "thag1.20:0.2": "Bộ Một Bài Kinh",
  "thag1.20:0.3": "Phẩm Thứ Hai",
  "thag1.20:0.4": "Kinh Kệ Của Trưởng Lão Ajita",
  "thag1.20:1.1": "“Cái chết không làm ta sợ,",
  "thag1.20:1.2": "ta cũng không tiếc đời sống;",
  "thag1.20:1.3": "Ta sẽ đặt thân này xuống,",
  "thag1.20:1.4": "tỉnh giác và chuyên chú.”",
  "thag1.20:1.5": "… Trưởng lão Ajita … ",
  "thag1.20:1.6": "Phẩm thứ hai, mười bài.",
  "thag1.20:2.0": "Tóm lược:",
  "thag1.20:2.1": "Cūḷavaccha, Mahāvaccha,",
  "thag1.20:2.2": "Vanavaccha và Sīvaka;",
  "thag1.20:2.3": "Kuṇḍadhāna và Belaṭṭhi,",
  "thag1.20:2.4": "Dāsaka và những vị kế tiếp;",
  "thag1.20:2.5": "Trưởng lão Siṅgālapitika,",
  "thag1.20:2.6": "cùng Kula và Ajita, mười vị."
}
