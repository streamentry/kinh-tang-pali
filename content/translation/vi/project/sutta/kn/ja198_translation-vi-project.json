{
  "ja198:0.1": "Jātaka",
  "ja198:0.2": "Bộ Hai Bài Kinh",
  "ja198:0.3": "Phẩm Ruhaka",
  "ja198:0.4": "8. Kinh Rādha",
  "ja198:1.1": "“Từ chuyến đi xa trở về, con ơi,",
  "ja198:1.2": "giờ đây con mới về, chưa bao lâu;",
  "ja198:1.3": "Phải chăng, con ơi, mẹ con",
  "ja198:1.4": "không thân cận người khác?”",
  "ja198:2.1": "“Thật chẳng nên nói ra",
  "ja198:2.2": "lời gắn với sự thật;",
  "ja198:2.3": "kẻo phải nằm như Poṭṭhapāda,",
  "ja198:2.4": "bị thiêu trong tro nóng”.",
  "ja198:3.1": "Kinh Rādha thứ tám."
}
