{
  "ja146:0.1": "Jātaka",
  "ja146:0.2": "Bộ Một Bài Kinh",
  "ja146:0.3": "Phẩm Kakaṇṭaka",
  "ja146:0.4": "6. Kinh Quạ Biển",
  "ja146:1.1": "“Hàm đã mỏi rã rời,",
  "ja146:1.2": "và miệng thì khô khốc;",
  "ja146:1.3": "Chúng ta kẹt lại bờ này, không qua được bờ bên kia,",
  "ja146:1.4": "đại dương cứ đầy mãi”.",
  "ja146:2.1": "Kinh Quạ Biển thứ sáu."
}
