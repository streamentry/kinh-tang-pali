{
  "ja180:0.1": "Jātaka",
  "ja180:0.2": "Bộ Hai Bài Kinh",
  "ja180:0.3": "Phẩm Pháp Lành",
  "ja180:0.4": "10. Kinh Điều Khó Cho",
  "ja180:1.1": "“Cho điều khó cho,",
  "ja180:1.2": "làm việc khó làm;",
  "ja180:1.3": "kẻ xấu không làm theo,",
  "ja180:1.4": "đức lành khó chỉ dạy”.",
  "ja180:2.1": "“Vì thế, giữa bậc hiền thiện và kẻ xấu,",
  "ja180:2.2": "đường đi từ đây khác hẳn nhau;",
  "ja180:2.3": "kẻ xấu đi đến địa ngục,",
  "ja180:2.4": "bậc hiền thiện hướng đến cõi trời.",
  "ja180:3.1": "Kinh Điều Khó Cho, thứ mười.",
  "ja180:3.2": "Phẩm Pháp Lành thứ ba.",
  "ja180:4.1": "Tóm lược:",
  "ja180:5.1": "Susamaññamigādhibhū, Māṇavako,",
  "ja180:5.2": "Vāripahūtarūpa, Adicca, Upaṭṭhāna;",
  "ja180:5.3": "Sakaḷāyasatindukapaṅka, nữa,",
  "ja180:5.4": "Sududdadakena, Satadhamma — mười bài ấy”vậy."
}
