{
  "thag1.78:0.1": "Theragāthā 1.78",
  "thag1.78:0.2": "Bộ Một Bài Kinh",
  "thag1.78:0.3": "Phẩm Thứ Tám",
  "thag1.78:0.4": "Kinh Kệ Của Trưởng lão Meṇḍasira",
  "thag1.78:1.1": "“Lang thang qua bao kiếp sống,",
  "thag1.78:1.2": "chạy tìm mà không gặp,",
  "thag1.78:1.3": "Ta, kẻ sinh trong khổ này,",
  "thag1.78:1.4": "khối khổ đã tan rồi”ti.",
  "thag1.78:1.5": "… Trưởng lão Meṇḍasira …. "
}
