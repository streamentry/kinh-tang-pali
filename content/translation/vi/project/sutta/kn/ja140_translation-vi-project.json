{
  "ja140:0.1": "Jātaka",
  "ja140:0.2": "Bộ Một Bài Kinh",
  "ja140:0.3": "Phẩm Asampadāna",
  "ja140:0.4": "10. Kinh Con Quạ",
  "ja140:1.1": "“Chúng cứ luôn gào lên tiếng,",
  "ja140:1.2": "làm phiền khổ tất cả các thế giới;",
  "ja140:1.3": "Nên không ai trong chúng có quyền",
  "ja140:1.4": "trên bọn đồng loại quạ của chúng ta.”",
  "ja140:2.1": "Kinh Con Quạ, thứ mười.",
  "ja140:2.2": "Phẩm Asampadāna, thứ mười bốn.",
  "ja140:3.1": "Tóm lược:",
  "ja140:4.1": "Itarītara, Rakkhasi, Khemiyo,",
  "ja140:4.2": "Parosatapañha, Ābhassara, lại nữa;",
  "ja140:4.3": "Rồi Haṁsavaruttama, Babbujaṭa,",
  "ja140:4.4": "Paṭanaṭṭhaka, Kākavara — mười bài ấy."
}
