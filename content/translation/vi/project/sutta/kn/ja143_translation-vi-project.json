{
  "ja143:0.1": "Jātaka",
  "ja143:0.2": "Bộ Một Bài Kinh",
  "ja143:0.3": "Phẩm Kakaṇṭaka",
  "ja143:0.4": "3. Kinh Tỏa Sáng",
  "ja143:1.1": "“Óc ngươi đã văng ra,",
  "ja143:1.2": "đầu ngươi đã vỡ toác;",
  "ja143:1.3": "mọi xương sườn của ngươi đều gãy nát,",
  "ja143:1.4": "hôm nay quả thật ngươi ‘tỏa sáng’”.",
  "ja143:2.1": "Kinh Tỏa Sáng thứ ba."
}
