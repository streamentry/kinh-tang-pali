{
  "ja192:0.1": "Jātaka",
  "ja192:0.2": "Bộ Hai Bài Kinh",
  "ja192:0.3": "Phẩm Ruhaka",
  "ja192:0.4": "2. Kinh Sirikāḷakaṇṇi",
  "ja192:1.1": "“Người nữ hãy có dung mạo,",
  "ja192:1.2": "và nàng có giới hạnh;",
  "ja192:1.3": "Mà người nam lại không muốn nàng,",
  "ja192:1.4": "ngài có tin không, hỡi Mahosadha?”",
  "ja192:2.1": "“Tôi tin thật, này Đại vương,",
  "ja192:2.2": "người nam có thể là kẻ kém may mắn;",
  "ja192:2.3": "Sirī và Kāḷakaṇṇī,",
  "ja192:2.4": "không bao giờ gặp nhau.”",
  "ja192:3.1": "Kinh Sirikāḷakaṇṇi thứ hai."
}
