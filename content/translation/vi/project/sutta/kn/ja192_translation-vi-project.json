{
  "ja192:0.1": "Jātaka",
  "ja192:0.2": "Bộ Hai Bài Kinh",
  "ja192:0.3": "Phẩm Dây Leo",
  "ja192:0.4": "2. Kinh Sirikāḷakaṇṇijātaka",
  "ja192:1.1": "“Người nữ hãy có dung mạo,",
  "ja192:1.2": "và hãy có giới;",
  "ja192:1.3": "Còn người nam sẽ chẳng mong ở nàng,",
  "ja192:1.4": "ta đã hiểu rõ lắm”.",
  "ja192:2.1": "“Tôi tin thật, này Đại vương,",
  "ja192:2.2": "người nam sẽ khó gả con gái;",
  "ja192:2.3": "Cả Sirī lẫn Kāḷakaṇṇī,",
  "ja192:2.4": "chưa bao giờ gặp nhau.”",
  "ja192:3.1": "Kinh Sirikāḷakaṇṇijātaka thứ hai."
}
