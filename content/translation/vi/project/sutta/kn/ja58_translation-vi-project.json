{
  "ja58:0.1": "Jātaka",
  "ja58:0.2": "Bộ Một Bài Kinh",
  "ja58:0.3": "Phẩm Hy Vọng",
  "ja58:0.4": "8. Kinh Ba Pháp",
  "ja58:1.1": "“Người nào có ba pháp này,",
  "ja58:1.2": "vua khỉ, y như Ngài;",
  "ja58:1.3": "khéo léo, dũng mãnh, tuệ,",
  "ja58:1.4": "thì người ấy vượt khỏi kẻ thù trước mặt”.",
  "ja58:2.1": "Kinh Ba Pháp thứ tám."
}
