{
  "ja8:0.1": "Jātaka",
  "ja8:0.2": "Bộ Một Bài Kinh",
  "ja8:0.3": "Phẩm Bụi Dơ",
  "ja8:0.4": "8. Kinh Gāmaṇī",
  "ja8:1.1": "“Dù không hấp tấp,",
  "ja8:1.2": "kẻ mong quả báo ấy vẫn được đạt;",
  "ja8:1.3": "Ta là người có phạm hạnh chín muồi,",
  "ja8:1.4": "hãy biết điều này, Gāmaṇī”.",
  "ja8:2.1": "Kinh Gāmaṇī, thứ tám."
}
