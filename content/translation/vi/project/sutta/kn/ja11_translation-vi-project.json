{
  "ja11:0.1": "Jātaka",
  "ja11:0.2": "Bộ Một Bài Kinh",
  "ja11:0.3": "Phẩm Giới",
  "ja11:0.4": "1. Kinh Nai Lakkhaṇa",
  "ja11:1.1": "“Giữ giới thì có ý nghĩa,",
  "ja11:1.2": "giữ đạo hạnh điều hoà giữa người;",
  "ja11:1.3": "Hãy nhìn Lakkhaṇa đang đến,",
  "ja11:1.4": "được bà con cùng tộc vây quanh;",
  "ja11:1.5": "Rồi hãy nhìn Kāḷa này,",
  "ja11:1.6": "như bị bỏ rơi hẳn vì sợ bà con”ti.",
  "ja11:2.1": "Kinh Nai Lakkhaṇa thứ nhất."
}
