{
  "thag1.80:0.1": "Theragāthā 1.80",
  "thag1.80:0.2": "Bộ Một Bài Kinh",
  "thag1.80:0.3": "Phẩm Thứ Tám",
  "thag1.80:0.4": "Kinh Kệ Của Trưởng Lão Ugga",
  "thag1.80:1.1": "“Việc gì ta đã làm,",
  "thag1.80:1.2": "dù ít hay nhiều,",
  "thag1.80:1.3": "tất cả đều đã cạn ráo,",
  "thag1.80:1.4": "nay không còn tái sinh nữa.”",
  "thag1.80:1.5": "… Trưởng lão Ugga … ",
  "thag1.80:1.6": "Phẩm thứ tám, mười bài.",
  "thag1.80:2.0": "Tóm lược:",
  "thag1.80:2.1": "Trưởng lão Vacchapāla,",
  "thag1.80:2.2": "Ātuma, Māṇava là bậc Muni;",
  "thag1.80:2.3": "Suyāmana, Susārada,",
  "thag1.80:2.4": "Trưởng lão Piyañjaha;",
  "thag1.80:2.5": "con trai Āroha, Meṇḍasira,",
  "thag1.80:2.6": "Rakkhito, vì kính Trưởng lão Ugga vậy."
}
