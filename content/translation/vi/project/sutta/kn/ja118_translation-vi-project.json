{
  "ja118:0.1": "Jātaka",
  "ja118:0.2": "Bộ Một Bài Kinh",
  "ja118:0.3": "Phẩm Haṁci",
  "ja118:0.4": "8. Kinh Chim Cút",
  "ja118:1.1": "“Người không suy xét,",
  "ja118:1.2": "không đạt được lối thoát;",
  "ja118:1.3": "Hãy xem quả của điều đã suy nghĩ;",
  "ja118:1.4": "ta đã thoát khỏi giết hại và trói buộc.”",
  "ja118:2.1": "Kinh Chim Cút, thứ tám."
}
