{
  "thag1.115:0.1": "Theragāthā 1.115",
  "thag1.115:0.2": "Bộ Một Bài Kinh",
  "thag1.115:0.3": "Phẩm Thứ Mười Hai",
  "thag1.115:0.4": "Kinh Kệ Của Trưởng Lão Mahānāma",
  "thag1.115:1.1": "“Núi này làm ngươi kém hơn,",
  "thag1.115:1.2": "với lớp cây bụi dày đặc;",
  "thag1.115:1.3": "còn núi Nesādaka thì",
  "thag1.115:1.4": "có tán phủ rực rỡ”ti.",
  "thag1.115:1.5": "… Trưởng lão Mahānāma …. "
}
