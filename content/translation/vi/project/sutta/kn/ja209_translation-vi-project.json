{
  "ja209:0.1": "Jātaka",
  "ja209:0.2": "Tập Kẻ Đau Đớn",
  "ja209:0.3": "Phẩm Bó Lúa",
  "ja209:0.4": "9. Kinh Chim Cút",
  "ja209:1.1": "“Cây cối trong rừng ta đã thấy,",
  "ja209:1.2": "toàn trắng, đáng kinh sợ;",
  "ja209:1.3": "Chúng đâu có được như thế,",
  "ja209:1.4": "như cây, ngươi có được”.",
  "ja209:2.1": "“Con cút già ấy kia,",
  "ja209:2.2": "đã dọa gà mái rồi tới đây;",
  "ja209:2.3": "khéo tay trong nghề thợ,",
  "ja209:2.4": "đi mất, nói rằng”.",
  "ja209:3.1": "Kinh Chim Cút thứ chín."
}
