{
  "ja98:0.1": "Jātaka",
  "ja98:0.2": "Nhóm Một Kệ",
  "ja98:0.3": "Phẩm Litta",
  "ja98:0.4": "8. Kinh Thương Nhân Gian Dối",
  "ja98:1.1": "“Quả thật tốt thay người tên Paṇḍita,",
  "ja98:1.2": "nhưng không phải Atipaṇḍita;",
  "ja98:1.3": "vì người con Atipaṇḍita,",
  "ja98:1.4": "ta đã bị cháy sém.”",
  "ja98:2.1": "Kinh Thương Nhân Gian Dối, thứ tám."
}
