{
  "ja71:0.1": "Jātaka",
  "ja71:0.2": "Bộ Một Bài Kinh",
  "ja71:0.3": "Phẩm Cây Varuṇa",
  "ja71:0.4": "1. Kinh Varuṇajātaka",
  "ja71:1.1": "“Kẻ nào trước kia làm",
  "ja71:1.2": "những việc cần làm, sau đó lại muốn làm;",
  "ja71:1.3": "như kẻ chặt cành cây Varuṇa,",
  "ja71:1.4": "về sau hối tiếc.”",
  "ja71:2.1": "Kinh Varuṇajātaka thứ nhất."
}
