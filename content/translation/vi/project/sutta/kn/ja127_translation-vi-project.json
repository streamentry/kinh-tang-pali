{
  "ja127:0.1": "Jātaka",
  "ja127:0.2": "Bộ Một Bài Kinh",
  "ja127:0.3": "Phẩm Lau Kusa",
  "ja127:0.4": "7. Kinh Con Sóc",
  "ja127:1.1": "“Những xứ ấy, những nơi ấy,",
