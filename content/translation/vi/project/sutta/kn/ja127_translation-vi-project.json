{
  "ja127:0.1": "Jātaka",
  "ja127:0.2": "Nhóm Một Kệ",
  "ja127:0.3": "Phẩm Lau Kusa",
  "ja127:0.4": "7. Kinh Kalaṇḍuka",
  "ja127:1.1": "“Những xứ ấy, những nơi ấy,",
  "ja127:1.2": "còn ta sống trong rừng;",
  "ja127:1.3": "Họ dò xét rồi ắt sẽ bắt ngươi;",
  "ja127:1.4": "hãy uống sữa đi, Kalaṇḍuka”.",
  "ja127:2.1": "Kinh Kalaṇḍuka, thứ bảy."
}
