{
  "ja170:0.1": "Jātaka",
  "ja170:0.2": "Bộ Hai Bài Kinh",
  "ja170:0.3": "Phẩm Santhava",
  "ja170:0.4": "10. Kinh Tắc Kè",
  "ja170:1.1": "“Con vật này trước kia không ngẩng cao,",
  "ja170:1.2": "con tắc kè trên đỉnh cổng;",
  "ja170:1.3": "Mahosadha, hãy tìm hiểu,",
  "ja170:1.4": "vì sao con tắc kè ngạo nghễ”.",
  "ja170:2.1": "“Đã được thứ chưa từng được,",
  "ja170:2.2": "nửa đồng māsa, con tắc kè",
  "ja170:2.3": "coi thường đức vua,",
  "ja170:2.4": "Vedeha, chủ thành Mithilā.”",
  "ja170:3.1": "Kinh Tắc Kè, thứ mười.",
  "ja170:3.2": "Phẩm Santhava thứ hai.",
  "ja170:4.1": "Tóm lược:",
  "ja170:5.1": "Rồi Indasamāna, cùng chòi lá,",
  "ja170:5.2": "Susimuttama, Gijjha, Jalābujako;",
  "ja170:5.3": "Upasāḷaka, nhà sư, salāpavaro,",
  "ja170:5.4": "Rồi Mettavara, mười phần lành trọn vẹn."
}
