{
  "thag2.7:0.1": "Theragāthā 2.7",
  "thag2.7:0.2": "Bộ Hai Bài Kinh",
  "thag2.7:0.3": "Phẩm Thứ Nhất",
  "thag2.7:0.4": "Kinh Kệ Của Trưởng Lão Rādha",
  "thag2.7:1.1": "“Như ngôi nhà lợp dở,",
  "thag2.7:1.2": "mưa thấm vào;",
  "thag2.7:1.3": "cũng vậy, tâm không tu tập,",
  "thag2.7:1.4": "tham thấm vào.",
  "thag2.7:2.1": "Như ngôi nhà lợp khéo,",
  "thag2.7:2.2": "mưa không thấm vào;",
  "thag2.7:2.3": "cũng vậy, tâm khéo tu tập,",
  "thag2.7:2.4": "tham không thấm vào”ti.",
  "thag2.7:2.5": "… Tôn giả Trưởng lão Rādho …."
}
