{
  "thag1.50:0.1": "Theragāthā 1.50",
  "thag1.50:0.2": "Bộ Một Bài Kinh",
  "thag1.50:0.3": "Phẩm Thứ Năm",
  "thag1.50:0.4": "Kinh Kệ Của Trưởng Lão Vimala",
  "thag1.50:1.1": "“Hồ Dharaṇī đang đổ mưa rào,",
  "thag1.50:1.2": "gió giáp ngàn thổi trên cao;",
  "thag1.50:1.3": "Phần tán chế của ta lắng xuống,",
  "thag1.50:1.4": "tâm ta đã điền tịnh.”",
  "thag1.50:1.5": "… Trưởng lão Vimala … ",
  "thag1.50:1.6": "Phẩm thứ năm, mười bài.",
  "thag1.50:2.0": "Tóm lược:",
  "thag1.50:2.1": "Trưởng lão Sirīvaḍḍha, Trưởng lão Revata,",
  "thag1.50:2.2": "Trưởng lão Sumaṅgala, Sānusavhaya;",
  "thag1.50:2.3": "Ramaṇīyavihārī nữa vậy,",
  "thag1.50:2.4": "Samiddhi và Sañjaya;",
  "thag1.50:2.5": "Trưởng lão Rāmaṇeyya ấy,",
  "thag1.50:2.6": "cùng Vimala thì hân hoan vậy."
}
