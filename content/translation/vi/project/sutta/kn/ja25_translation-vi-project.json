{
  "ja25:0.1": "Jātaka",
  "ja25:0.2": "Bộ Một Bài Kinh",
  "ja25:0.3": "Phẩm Nai Bốn Sừng",
  "ja25:0.4": "5. Kinh Bến Lội",
  "ja25:1.1": "“Dù bến này hay bến khác,",
  "ja25:1.2": "này người đánh xe, hãy cho ngựa uống nước;",
  "ja25:1.3": "với kẻ ăn quá độ,",
  "ja25:1.4": "ngay cả cháo sữa cũng thành cực hình.”",
  "ja25:2.1": "Kinh Bến Lội thứ năm."
}
