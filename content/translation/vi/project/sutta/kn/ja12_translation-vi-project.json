{
  "ja12:0.1": "Jātaka",
  "ja12:0.2": "Bộ Một Bài Kinh",
  "ja12:0.3": "Phẩm Giới",
  "ja12:0.4": "2. Kinh Con Nai Nigrodha",
  "ja12:1.1": "“Chỉ nên gần gũi Nigrodha,",
  "ja12:1.2": "chớ chung sống với Sākha;",
  "ja12:1.3": "Thà chết bên Nigrodha,",
  "ja12:1.4": "còn hơn sống bên Sākha”.",
  "ja12:2.1": "Kinh Con Nai Nigrodha thứ hai."
}
