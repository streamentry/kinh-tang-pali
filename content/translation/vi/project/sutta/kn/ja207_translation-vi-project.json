{
  "ja207:0.1": "Jātaka",
  "ja207:0.2": "Tập Kẻ Đau Đớn",
  "ja207:0.3": "Phẩm Bó Lúa",
  "ja207:0.4": "7. Kinh Vua Assaka",
  "ja207:1.1": "“Vị vua Assaka này",
  "ja207:1.2": "đã đi khắp vùng đất này;",
  "ja207:1.3": "đầy lòng mong muốn,",
  "ja207:1.4": "cùng người chồng thân yêu.",
  "ja207:2.1": "Với sự vui-khổ mới mới,",
  "ja207:2.2": "cái cũ bị che lấp;",
  "ja207:2.3": "Nên, bậc vua Assaka,",
  "ja207:2.4": "ngươi còn thân hơn ta”.",
  "ja207:3.1": "Kinh Vua Assaka thứ bảy."
}
