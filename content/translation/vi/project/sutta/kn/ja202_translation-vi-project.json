{
  "ja202:0.1": "Jātaka",
  "ja202:0.2": "Bộ Hai Bài Kinh",
  "ja202:0.3": "Phẩm Bó Lúa",
  "ja202:0.4": "2. Kinh Keḷisīla",
  "ja202:1.1": "“Ngỗng trời, diệc và công,",
  "ja202:1.2": "voi, nai đốm, nai;",
  "ja202:1.3": "Tất cả đều sợ sư tử,",
  "ja202:1.4": "thân không có bằng nhau.",
  "ja202:2.1": "Cũng vậy giữa loài người,",
  "ja202:2.2": "trẻ mà có trí;",
  "ja202:2.3": "Vị ấy ở đó là lớn,",
  "ja202:2.4": "chứ không phải kẻ ngu có thân hình”.",
  "ja202:3.1": "Kinh Keḷisīla thứ hai."
}
