{
  "ja56:0.1": "Jātaka",
  "ja56:0.2": "Bộ Một Bài Kinh",
  "ja56:0.3": "Phẩm Hy Vọng",
  "ja56:0.4": "6. Kinh Đống Vàng",
  "ja56:1.1": "“Người có tâm được tinh luyện,",
  "ja56:1.2": "có ý được tinh luyện;",
  "ja56:1.3": "trau dồi thiện pháp,",
  "ja56:1.4": "để mong đạt sự an ổn, thoát khỏi gông trói;",
  "ja56:1.5": "sẽ tuần tự đạt đến",
  "ja56:1.6": "sự tận diệt mọi kiết sử.”",
  "ja56:2.1": "Kinh Đống Vàng thứ sáu."
}
