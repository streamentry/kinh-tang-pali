{
  "thag1.39:0.1": "Theragāthā 1.39",
  "thag1.39:0.2": "Bộ Một Bài Kinh",
  "thag1.39:0.3": "Phẩm Thứ Tư",
  "thag1.39:0.4": "Kinh Kệ Của Trưởng Lão Tissa",
  "thag1.39:1.1": "“Như bị mũi thương đâm phải,",
  "thag1.39:1.2": "như đầu đang bị thiêu đốt,",
  "thag1.39:1.3": "để đoạn trừ tham dục,",
  "thag1.39:1.4": "tỳ-kheo hãy sống chánh niệm.”",
  "thag1.39:1.5": "… Trưởng lão Tissa …."
}
