{
  "ja158:0.1": "Jātaka",
  "ja158:0.2": "Bộ Hai Bài Kinh",
  "ja158:0.3": "Phẩm Kiên Cố",
  "ja158:0.4": "8. Kinh Suhanu",
  "ja158:1.1": "“Chẳng phải điều này với Soṇa nết bất chính,",
  "ja158:1.2": "Suhanu ở cùng với nó;",
  "ja158:1.3": "Suhanu cũng y như thế,",
  "ja158:1.4": "kẻ cùng chỗ kiếm ăn với Soṇa.",
  "ja158:2.1": "Hay xông tới, trơ trẽn,",
  "ja158:2.2": "luôn gặm dây buộc;",
  "ja158:2.3": "Ác hợp với ác,",
  "ja158:2.4": "bất chính hợp với bất chính.”",
  "ja158:3.1": "Kinh Suhanu thứ tám."
}
