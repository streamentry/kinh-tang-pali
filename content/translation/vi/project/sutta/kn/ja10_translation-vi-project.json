{
  "ja10:0.1": "Jātaka",
  "ja10:0.2": "Bộ Một Bài Kinh",
  "ja10:0.3": "Phẩm Bụi Dơ",
  "ja10:0.4": "10. Kinh Người Sống An Nhàn",
  "ja10:1.1": "“Kẻ không được ai che chở,",
  "ja10:1.2": "kẻ không che chở ai,",
  "ja10:1.3": "thật sự ngủ yên, này Đại vương,",
  "ja10:1.4": "không màng đến dục trần”ti.",
  "ja10:2.1": "Kinh Người Sống An Nhàn, thứ mười.",
  "ja10:2.2": "Phẩm Bụi Dơ, thứ nhất.",
  "ja10:3.1": "Tóm lược:",
  "ja10:4.1": "Varāpaṇṇaka, Vaṇṇupatha, Serivaro,",
  "ja10:4.2": "Suvicakkhaṇa, Taṇḍulanāḷikassā;",
  "ja10:4.3": "Hiri, Puttavarutta, Gāmaṇī,",
  "ja10:4.4": "cùng Yo-ca-na-rakkhati — mười bài ấy."
}
