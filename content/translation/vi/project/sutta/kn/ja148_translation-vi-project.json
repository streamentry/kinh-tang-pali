{
  "ja148:0.1": "Jātaka",
  "ja148:0.2": "Bộ Một Bài Kinh",
  "ja148:0.3": "Phẩm Kakaṇṭaka",
  "ja148:0.4": "8. Kinh Chó Rừng",
  "ja148:1.1": "“Không lần nữa, không lần nữa,",
  "ja148:1.2": "cũng không bao giờ, bao giờ nữa,",
  "ja148:1.3": "ta chui vào thân voi;",
  "ja148:1.4": "vì ta đã khiếp sợ đến thế này”.",
  "ja148:2.1": "Kinh Chó Rừng thứ tám."
}
