{
  "ja95:0.1": "Jātaka",
  "ja95:0.2": "Nhóm Một Kệ",
  "ja95:0.3": "Phẩm Litta",
  "ja95:0.4": "5. Kinh Mahāsudassana",
  "ja95:1.1": "“Ôi, các hành là vô thường!",
  "ja95:1.2": "bản chất là sinh, diệt;",
  "ja95:1.3": "đã sinh ra rồi chấm dứt,",
  "ja95:1.4": "sự lắng dịu của chúng là hạnh phúc”.",
  "ja95:2.1": "Kinh Mahāsudassana, thứ năm."
}
