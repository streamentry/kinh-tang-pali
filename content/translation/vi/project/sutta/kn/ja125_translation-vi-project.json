{
  "ja125:0.1": "Jātaka",
  "ja125:0.2": "Bộ Một Bài Kinh",
  "ja125:0.3": "Phẩm Lau Kusa",
  "ja125:0.4": "5. Kinh Kaṭāhaka",
  "ja125:1.1": "“Kẻ ấy khoe khoang nhiều,",
  "ja125:1.2": "dù đã đến xứ khác;",
  "ja125:1.3": "Trở về rồi phá hoại —",
  "ja125:1.4": "này Kaṭāhaka, hãy hưởng của cải”.",
  "ja125:2.1": "Kinh Kaṭāhaka thứ năm."
}
