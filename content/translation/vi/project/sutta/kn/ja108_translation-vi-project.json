{
  "ja108:0.1": "Jātaka",
  "ja108:0.2": "Bộ Một Bài Kinh",
  "ja108:0.3": "Phẩm Hơn Trăm",
  "ja108:0.4": "8. Kinh Bāhiya",
  "ja108:1.1": "“Hãy học những điều cần học,",
  "ja108:1.2": "vẫn có những người thật lòng muốn học;",
  "ja108:1.3": "Người đàn bà quê mùa ấy, nhờ nết khiêm tốn,",
  "ja108:1.4": "đã làm đẹp lòng vua.”",
  "ja108:2.1": "Kinh Bāhiya, thứ tám."
}
