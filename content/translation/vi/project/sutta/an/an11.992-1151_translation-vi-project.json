{
  "an11.992-1151:0.1": "Aṅguttara Nikāya 11.992–1151",
  "an11.992-1151:0.2": "1. Paṭhamapaṇṇāsaka",
  "an11.992-1151:0.3": "Tập Kệ Rút Gọn Bắt Đầu Bằng Tham",
  "an11.992-1151:0.4": "~",
  "an11.992-1151:1.1": "“Về oán giận … ….",
  "an11.992-1151:1.2": "về si…",
  "an11.992-1151:1.3": "về giận dữ…",
  "an11.992-1151:1.4": "về oán hận…",
  "an11.992-1151:1.5": "về chê bai…",
  "an11.992-1151:1.6": "về chê trách…",
  "an11.992-1151:1.7": "về ghen tị…",
  "an11.992-1151:1.8": "về keo kiệt…",
  "an11.992-1151:1.9": "về lừa dối…",
  "an11.992-1151:1.10": "về gian xảo…",
  "an11.992-1151:1.11": "về kiêu ngạo…",
  "an11.992-1151:1.12": "về hăng hái…",
  "an11.992-1151:1.13": "về ngạo mạn…",
  "an11.992-1151:1.14": "về kiêu mạn quá mức…",
  "an11.992-1151:1.15": "về say mê…",
  "an11.992-1151:1.16": "để thấy biết rõ sự phóng dật …",
  "an11.992-1151:1.17": "để liễu tri …",
  "an11.992-1151:1.18": "để đoạn trừ trọn vẹn …",
  "an11.992-1151:1.19": "để nhổ bỏ …",
  "an11.992-1151:1.20": "để chấm dứt …",
  "an11.992-1151:1.21": "để tan rã …",
  "an11.992-1151:1.22": "để ly tham …",
  "an11.992-1151:1.23": "để diệt tận …",
  "an11.992-1151:1.24": "để xả bỏ …",
  "an11.992-1151:1.25": "để buông bỏ trọn vẹn, cần phải tu tập mười một pháp này.”",
  "an11.992-1151:2.1": "Đức Thế Tôn nói vậy.",
  "an11.992-1151:2.2": "Các vị tỳ-kheo ấy hoan hỷ, tin nhận lời Đức Phật dạy.",
  "an11.992-1151:2.3": "Tập kệ bắt đầu bằng tham đã khép lại.",
  "an11.992-1151:3.1": "Chín nghìn bài kinh,",
  "an11.992-1151:3.2": "hơn là năm trăm;",
  "an11.992-1151:3.3": "bảy mươi bảy bài kinh,",
  "an11.992-1151:3.4": "đã quy thành Tăng Bộ.",
  "an11.992-1151:3.5": "Tập mười một phẩm của Tăng Bộ đã khép lại.",
  "an11.992-1151:3.6": "Tăng Bộ Aṅguttara đã hoàn tất."
}
