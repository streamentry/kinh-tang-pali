{
  "an11.992-1151:0.1": "Aṅguttara Nikāya 11.992–1151",
  "an11.992-1151:0.2": "Nhóm Năm Mươi Đầu",
  "an11.992-1151:0.3": "Chuỗi Lặp Tham",
  "an11.992-1151:0.4": "~",
  "an11.992-1151:1.1": "“Về sân …",
  "an11.992-1151:1.2": "về si …",
  "an11.992-1151:1.3": "về giận dữ …",
  "an11.992-1151:1.4": "về oán hận …",
  "an11.992-1151:1.5": "về khinh miệt …",
  "an11.992-1151:1.6": "về coi thường …",
  "an11.992-1151:1.7": "về ganh tị …",
  "an11.992-1151:1.8": "về keo kiệt …",
  "an11.992-1151:1.9": "về lừa dối …",
  "an11.992-1151:1.10": "về gian xảo …",
  "an11.992-1151:1.11": "về cứng đầu …",
  "an11.992-1151:1.12": "về hung hăng …",
  "an11.992-1151:1.13": "về mạn …",
  "an11.992-1151:1.14": "về quá mạn …",
  "an11.992-1151:1.15": "về kiêu căng …",
  "an11.992-1151:1.16": "về phóng dật, để thắng tri …",
  "an11.992-1151:1.17": "để hoàn toàn hiểu rõ …",
  "an11.992-1151:1.18": "để đoạn tận hoàn toàn …",
  "an11.992-1151:1.19": "để từ bỏ …",
  "an11.992-1151:1.20": "để đoạn tận …",
  "an11.992-1151:1.21": "để tan rã …",
  "an11.992-1151:1.22": "để ly tham …",
  "an11.992-1151:1.23": "để diệt …",
  "an11.992-1151:1.24": "để xả …",
  "an11.992-1151:1.25": "để buông bỏ, mười một pháp này cần được tu tập.”",
  "an11.992-1151:2.1": "Đức Phật đã nói như vậy.",
  "an11.992-1151:2.2": "Các vị tỳ-kheo ấy hoan hỷ, tin nhận lời Đức Phật dạy.",
  "an11.992-1151:2.3": "Chuỗi Lặp Tham đã hoàn tất.",
  "an11.992-1151:3.1": "Chín nghìn bài kinh,",
  "an11.992-1151:3.2": "và thêm năm trăm nữa;",
  "an11.992-1151:3.3": "năm mươi bảy bài kinh,",
  "an11.992-1151:3.4": "được kết hợp trong Tăng Bộ.",
  "an11.992-1151:3.5": "Chương Mười Một Pháp đã hoàn tất.",
  "an11.992-1151:3.6": "Tăng Bộ Aṅguttara đã hoàn tất."
}
