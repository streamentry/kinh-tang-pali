{
  "an11.983-991:0.1": "Aṅguttara Nikāya 11.983–991",
  "an11.983-991:0.2": "Nhóm Năm Mươi Đầu",
  "an11.983-991:0.3": "Tập Kệ Rút Gọn Bắt Đầu Bằng Tham",
  "an11.983-991:0.4": "~",
  "an11.983-991:1.1": "“Để hoàn toàn hiểu rõ tham, này các tỳ-kheo, …",
  "an11.983-991:1.10": "mười một pháp này cần được tu tập”.",
  "an11.983-991:1.2": "để đoạn tận hoàn toàn …",
  "an11.983-991:1.3": "để từ bỏ …",
  "an11.983-991:1.4": "để đoạn tận …",
  "an11.983-991:1.5": "để hủy hoại …",
  "an11.983-991:1.6": "để ly tham …",
  "an11.983-991:1.7": "để diệt …",
  "an11.983-991:1.8": "để xả …",
  "an11.983-991:1.9": "để buông bỏ …"
}
