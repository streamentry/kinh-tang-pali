{
  "an3.108:0.1": "Kinh Tăng Chi Bộ 3.108",
  "an3.108:0.2": "11. Phẩm Giác Ngộ",
  "an3.108:0.3": "Kinh Chưa Bao Giờ Thỏa",
  "an3.108:1.1": "“Có ba sự thỏa mãn chưa bao giờ đủ, này các tỳ-kheo.",
  "an3.108:1.2": "Thế nào là ba?",
  "an3.108:1.3": "Giấc ngủ,",
  "an3.108:1.4": "uống rượu bia,",
  "an3.108:1.5": "và giao hợp.",
  "an3.108:1.6": "Đây là ba sự thỏa mãn chưa bao giờ đủ.”",
  "an3.108:1.7": "Thứ sáu."
}
