{
  "an10.267-746:0.1": "Kinh Tăng Chi Bộ 10",
  "an10.267-746:0.2": "23. Chuỗi Lặp Tham",
  "an10.267-746:0.3": "~",
  "an10.267-746:1.1": "“Với sân …",
  "an10.267-746:1.2": "với si …",
  "an10.267-746:1.3": "với sân giận …",
  "an10.267-746:1.4": "với oán hận …",
  "an10.267-746:1.5": "với khinh miệt …",
  "an10.267-746:1.6": "với ngạo mạn …",
  "an10.267-746:1.7": "với ganh ghét …",
  "an10.267-746:1.8": "với keo kiệt …",
  "an10.267-746:1.9": "với gian xảo …",
  "an10.267-746:1.10": "với quỷ quyệt …",
  "an10.267-746:1.11": "với cứng cỏi …",
  "an10.267-746:1.12": "với hung hăng …",
  "an10.267-746:1.13": "với mạn …",
  "an10.267-746:1.14": "với mạn quá …",
  "an10.267-746:1.15": "với phóng túng …",
  "an10.267-746:1.16": "với phóng dật, để hoàn toàn hiểu rõ …",
  "an10.267-746:1.17": "để đoạn tận hoàn toàn …",
  "an10.267-746:1.18": "để từ bỏ …",
  "an10.267-746:1.19": "để đoạn tận …",
  "an10.267-746:1.20": "để hủy hoại …",
  "an10.267-746:1.21": "để ly tham …",
  "an10.267-746:1.22": "để diệt …",
  "an10.267-746:1.23": "(…) để xả …",
  "an10.267-746:1.24": "để buông bỏ …",
  "an10.267-746:1.25": "mười pháp này cần được tu tập.”",
  "an10.267-746:1.26": "Chuỗi Lặp Tham đã hoàn tất.",
  "an10.267-746:1.27": "Phần năm mươi kinh thứ năm hoàn tất.",
  "an10.267-746:1.28": "Kinh Chương Mười Lẻ hoàn tất."
}
