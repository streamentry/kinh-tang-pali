{
  "sn48.1:0.1": "Saṁyutta Nikāya 48.1",
  "sn48.1:0.2": "1. Phẩm Thanh Tịnh",
  "sn48.1:0.3": "Kinh Năm Căn",
  "sn48.1:1.1": "Tại Sāvatthī.",
  "sn48.1:1.2": "Tại đó Đức Phật nói:",
  "sn48.1:1.3": "“Có năm căn, này các tỳ-kheo.",
  "sn48.1:1.4": "Thế nào là năm?",
  "sn48.1:1.5": "Tín căn, tinh tấn căn, niệm căn, định căn, và tuệ căn—",
  "sn48.1:1.6": "này các tỳ-kheo, đây là năm căn”.",
  "sn48.1:1.7": "Thứ nhất."
}
