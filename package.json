{
  "name": "kinh-tang-pali",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run source:sync:used && npm run legacy:sync && astro dev",
    "build": "npm run source:sync:used && npm run legacy:sync && npm run validate && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "validate": "tsx scripts/validate.ts && npm run quality:check",
    "source:sync": "tsx scripts/sync-source.ts",
    "source:sync:used": "tsx scripts/sync-source.ts --used",
    "source:sync:all": "tsx scripts/sync-source.ts --all",
    "source:sync:manifest": "tsx scripts/sync-source.ts --manifest",
    "legacy:sync": "tsx scripts/sync-legacy-vi.ts",
    "legacy:check": "tsx scripts/sync-legacy-vi.ts --check",
    "source:sync:mn": "tsx scripts/sync-source.ts --collection mn",
    "manifest:fetch": "tsx scripts/fetch-upstream-manifest.ts",
    "manifest:check": "tsx scripts/fetch-upstream-manifest.ts --check",
    "catalog:import": "tsx scripts/import-canonical-catalogs.ts",
    "glossary:check": "tsx scripts/check-glossary.ts",
    "catalog:check": "tsx scripts/import-canonical-catalogs.ts --check",
    "verify:store": "tsx scripts/verify-store.ts",
    "verify:store:write": "tsx scripts/verify-store.ts --write",
    "verify:store:check": "tsx scripts/verify-store.ts --check",
    "verify:store:partial": "tsx scripts/verify-store.ts --check --allow-partial-cache",
    "audit:store": "tsx scripts/audit-store.ts",
    "doctor": "tsx scripts/doctor.ts",
    "license:generate": "tsx scripts/generate-notice.ts",
    "audit:reference": "tsx scripts/audit-reference.ts --used",
    "queue": "tsx scripts/queue.ts",
    "reference:gaps": "tsx scripts/record-reference-gaps.ts",
    "reference:gaps:check": "tsx scripts/record-reference-gaps.ts --check",
    "store": "tsx scripts/show-store.ts",
    "book:mn:epub": "tsx scripts/build-book.ts books/mn-vol-1.yaml epub",
    "book:mn:pdf": "tsx scripts/build-book.ts books/mn-vol-1.yaml pdf",
    "audit:dn-mn": "tsx scripts/audit-dn-mn.ts",
    "doctor:ci": "tsx scripts/doctor.ts --allow-partial-cache",
    "license:check": "tsx scripts/generate-notice.ts --check",
    "quality": "tsx scripts/assess-quality.ts",
    "quality:check": "tsx scripts/assess-quality.ts --check",
    "seo:check": "node --import tsx scripts/check-seo.ts",
    "audio:check": "node --import tsx scripts/check-audio-progress.ts",
    "design:generate": "node scripts/design-tokens.mjs && node scripts/brand-assets.mjs",
    "design:check": "node scripts/design-tokens.mjs --check && node scripts/brand-assets.mjs --check"
  },
  "dependencies": {
    "astro": "7.3.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.2",
    "pagefind": "1.5.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  }
}
