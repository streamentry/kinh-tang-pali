# No runtime secrets are required for the static reader.
# Cloudflare Pages deployment credentials belong in platform/GitHub secrets, not here.

# Optional offline narration scripts only. Never expose these in the static reader.
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional S3 transport for large narration objects; scope to the audio bucket.
# Existing OAuth/API token is still used to verify the pinned managed domain.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Only when using temporary S3 credentials.
R2_SESSION_TOKEN=
